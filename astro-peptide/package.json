{
  "name": "astro-peptide-research",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "astro": "astro",
    "brand:rasters": "node scripts/generate-brand-rasters.mjs",
    "build": "astro build",
    "check": "astro check",
    "check:i18n": "node scripts/check-i18n-coverage.mjs",
    "coa:check": "node scripts/check-coa-lots.mjs",
    "dev": "astro dev",
    "launch:check": "npm run seo:check && npm run legal:check && npm run legal:claims && npm run coa:check && npm run launch:readiness",
    "launch:readiness": "node scripts/check-launch-readiness.mjs",
    "legal:check": "node scripts/check-legal-readiness.mjs",
    "legal:claims": "node scripts/check-ymyl-claims.mjs",
    "photos:check": "node scripts/ingest-product-photos.mjs --check",
    "photos:ingest": "node scripts/ingest-product-photos.mjs",
    "prebuild": "npm run seo:feeds",
    "preview": "astro preview",
    "seo:check": "npm run build && npm run seo:hreflang && npm run seo:i18n",
    "seo:feeds": "node scripts/generate-merchant-feeds.mjs",
    "seo:hreflang": "node scripts/validate-hreflang.mjs",
    "seo:i18n": "node scripts/check-i18n-coverage.mjs",
    "start": "astro dev",
    "test:a11y": "pa11y-ci --config .pa11yci.json",
    "test:e2e": "playwright test",
    "test:lhci": "lhci autorun --config=lighthouserc.cjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.3.1",
    "@astrojs/react": "^5.0.4",
    "@astrojs/sitemap": "^3.7.2",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/inter-tight": "^5.2.7",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@nanostores/react": "^1.1.0",
    "astro": "^6.2.2",
    "nanostores": "^1.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "playwright": "^1.62.1",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "wrangler": "^4.87.0"
  }
}
