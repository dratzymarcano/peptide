---
/**
 * Homepage — a linear story rather than a directory.
 *
 * The previous build ran ten sections and ~1,000 words before it finished, and
 * put the first product below four blocks of prose about why the products are
 * good. It also "featured" the eight cheapest items in the catalogue, which are
 * the mass-spec reference standards nobody arrives looking for, illustrated
 * with placeholder line art.
 *
 * The order now matches the questions a buyer actually asks: what is this,
 * what can I buy, how do I know it is real, what happens when I order, what if
 * something goes wrong. Every claim on the page traces to something the site
 * can substantiate — the purity floor in the product frontmatter, the shipping
 * and returns terms in src/lib/pricing.ts, the certificate policy. There are
 * no review counts, customer totals or ratings, because none of those exist
 * yet; inventing them is what the "Remove fabricated trust signals" commit
 * already had to undo once.
 */
import Layout from '../layouts/Layout.astro';
import JsonLd from '../components/JsonLd.astro';
import ProductCard from '../components/ProductCard.astro';
import TrustBar from '../components/TrustBar.astro';
import { toCardProduct } from '../lib/product';
import { useCases } from '../data/taxonomy';
import { getCanonicalCollection } from '../lib/collections';
import { getLocaleFromPathname, localizePath } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import { productsWithLots } from '../lib/coa/lots';
import { DEFAULT_LOCALE as DEFAULT_COA_LOCALE, SUPPORTED_LOCALES as SUPPORTED_COA_LOCALES } from '../lib/coa/i18n';
import { MIN_ORDER_AMOUNT, FREE_DELIVERY_THRESHOLD, SHIPPING_COSTS } from '../lib/pricing';
import { inLanguage, organizationSchema, localBusinessSchema, websiteSchema, faqSchema } from '../lib/schema';

export const prerender = false;

const locale = (Astro.locals.locale ?? getLocaleFromPathname(Astro.url.pathname));
const t = useTranslations(locale);
const href = (path: string) => localizePath(path, locale);
const siteUrl = 'https://peptide-kaufen.net';

const products = (await getCanonicalCollection('products'))
  .filter((product) => product.data.category !== 'supplies');

/*
 * Ordered by the search demand recorded in each product's frontmatter, which
 * is the only ranking signal on the site that reflects what buyers actually
 * want. It also happens to select the 22 products that have real photography —
 * the placeholder-illustrated reference standards all sit at zero.
 */
const toVolume = (value: number | string | undefined) =>
  typeof value === 'number' ? value : Number.parseInt(String(value ?? '0').replace(/\D/g, ''), 10) || 0;
const popularProducts = [...products]
  .sort((a, b) => toVolume(b.data.search_volume) - toVolume(a.data.search_volume))
  .slice(0, 8);

const totalProducts = products.length;

/*
 * The certificate section adapts to what the site can actually show. While
 * src/data/coa-lots.json is empty every /coa/ page renders "available on
 * request", so linking a "read it now" call to action would send people to a
 * page that contradicts it. Transcribe one real lab report into the registry
 * and this block starts pointing at the document itself.
 */
// Serve the sample certificate in the language of the page. The COA module
// keeps its own default (English, unsuffixed filename); with German now at the
// site root, linking that default would hand most visitors a certificate in a
// language they did not ask for.
const pageCoaLocale = (SUPPORTED_COA_LOCALES as readonly string[]).includes(locale)
  ? (locale as (typeof SUPPORTED_COA_LOCALES)[number])
  : DEFAULT_COA_LOCALE;
const coaSuffix = pageCoaLocale === DEFAULT_COA_LOCALE ? '' : `.${pageCoaLocale}`;

const slugsWithLots = new Set(productsWithLots());
const sampleCoaSlug = popularProducts.find((product) => slugsWithLots.has(product.id))?.id
  ?? productsWithLots()[0]
  ?? null;

const storySteps = [1, 2, 3, 4].map((n) => ({
  n,
  title: t(`about.timeline${n}Title`),
  body: t(`about.timeline${n}Body`),
}));

const homeFaqs = [
  { q: t('support.faqCoaQ'), a: t('support.faqCoaA') },
  { q: t('support.faqHplcQ'), a: t('support.faqHplcA') },
  { q: t('support.faqMinimumQ'), a: t('support.faqMinimumA') },
  { q: t('support.faqStorageQ'), a: t('support.faqStorageA') },
  { q: t('support.faqHumanUseQ'), a: t('support.faqHumanUseA') },
];

const money = (value: number) => (Number.isInteger(value) ? String(value) : value.toFixed(2));
const orderFacts = [
  { title: t('home.orderMinTitle', { min: money(MIN_ORDER_AMOUNT) }), body: t('home.orderMinBody', { min: money(MIN_ORDER_AMOUNT) }) },
  {
    title: t('home.orderShipTitle', { standard: money(SHIPPING_COSTS.standard) }),
    body: t('home.orderShipBody', {
      standard: money(SHIPPING_COSTS.standard),
      express: money(SHIPPING_COSTS.express),
      freeFrom: money(FREE_DELIVERY_THRESHOLD),
    }),
  },
  { title: t('home.orderPayTitle'), body: t('home.orderPayBody', { btcDiscount: 10 }) },
  { title: t('home.orderReturnsTitle'), body: t('home.orderReturnsBody') },
];

/*
 * Feedback for the footer newsletter form, which posts to /api/newsletter and
 * redirects back here with a status. Rendered server-side rather than as a
 * toast so it survives the redirect and is readable without JavaScript.
 */
const NEWSLETTER_STATES = ['pending', 'confirmed', 'expired', 'invalid', 'error'] as const;
const requestedNewsletterState = Astro.url.searchParams.get('newsletter');
const newsletterState = (NEWSLETTER_STATES as readonly string[]).includes(requestedNewsletterState ?? '')
  ? (requestedNewsletterState as (typeof NEWSLETTER_STATES)[number])
  : null;
const newsletterIsProblem = newsletterState === 'expired' || newsletterState === 'invalid' || newsletterState === 'error';

const websiteJsonLd = websiteSchema({
  locale,
  homeUrl: `${siteUrl}${href('/')}`,
  searchUrl: `${siteUrl}${href('/search/')}`,
});
const organizationJsonLd = organizationSchema({ locale });
const localBusinessJsonLd = localBusinessSchema({ locale });
const popularItemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: t('home.schemaFeaturedProducts'),
  inLanguage: inLanguage(locale),
  itemListElement: popularProducts.map((product, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: `${siteUrl}${href(`/peptides/${product.id}/`)}`,
    name: product.data.title,
  })),
};
// The five Q&As below are rendered on the page, so they are eligible for the
// FAQ rich result rather than schema describing content that is not visible.
const homeFaqJsonLd = faqSchema(homeFaqs, locale);
const speakableSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${siteUrl}${href('/')}`,
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['.hero-title', '.hero-lead'],
  },
};
---

<Layout
  title={t('home.metaTitle')}
  description={t('home.metaDescription')}
  preloadImage="/images/site/peptide-kaufen.webp"
>
  <JsonLd schema={[websiteJsonLd, organizationJsonLd, localBusinessJsonLd, popularItemList, homeFaqJsonLd, speakableSchema]} />

  {newsletterState && (
    <div class="container">
      <p
        class:list={['newsletter-status', newsletterIsProblem && 'newsletter-status--problem']}
        role={newsletterIsProblem ? 'alert' : 'status'}
      >
        {t(`newsletter.${newsletterState}`)}
      </p>
    </div>
  )}

  <!-- 1 · HERO: Centralized with Background Image ------------------------ -->
  <section class="hero-shot">
    <div class="hero-shot__overlay" aria-hidden="true"></div>
    <div class="container hero-shot__inner">
      <div class="hero-center">
        <h1 class="hero-title">{t('home.heroTitle')}</h1>
        <p class="hero-lead">{t('home.heroLead')}</p>
        <div class="hero-actions">
          <a class="btn btn-primary btn-lg hero-cta-btn" href={href('/shop/')}>
            <span>{t('home.heroPrimary')}</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </a>
          <a class="btn btn-hero-ghost btn-lg" href="#certificate">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
            <span>{t('home.heroSecondary')}</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 2 · TRUST BAR: four scientific pillars -------------------------------- -->
  <TrustBar tone="dark" />

  <!-- 3 · PRODUCTS: before any further argument -------------------------- -->
  <section class="section" aria-labelledby="popular-title">
    <div class="container">
      <div class="band-head">
        <div>
          <h2 id="popular-title" class="band-title">{t('home.popularTitle')}</h2>
        </div>
        <a class="btn btn-secondary" href={href('/shop/')}>{t('home.popularAction', { count: totalProducts })}</a>
      </div>

      <div class="grid grid-4 popular-grid">
        {popularProducts.map((product) => (
          <ProductCard product={toCardProduct(product, locale)} />
        ))}
      </div>
    </div>
  </section>

  <!-- 3.5 · SCIENTIFIC QUALITY BENCHMARK BENTO ------------------------------ -->
  <section class="section surface-soft" aria-labelledby="benchmark-title">
    <div class="container">
      <div class="band-head band-head--stacked">
        <div>
          <h2 id="benchmark-title" class="band-title">Warum ungetestete Peptide Forschungsergebnisse verfälschen</h2>
          <p class="band-lead">In der In-vitro- und Zellforschung führen Reinheitsdefizite, TFA-Rückstände und Enantiomeren-Gemische zu nicht reproduzierbaren Resultaten. Unser 4-Pfeiler-Standard garantiert wissenschaftliche Validität.</p>
        </div>
      </div>

      <div class="benchmark-grid">
        <div class="benchmark-card">
          <div class="benchmark-icon benchmark-icon--blue">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
          </div>
          <h3>RP-HPLC Reinheit ≥99 %</h3>
          <p>Herstellung via cGMP Solid-Phase Peptid Synthese (SPPS). Vollständige Abtrennung verkürzter Sequenzen und Synthesenebenprodukte für klare experimentelle Signale.</p>
          <span class="benchmark-tag">Keine Deletionspeptide</span>
        </div>

        <div class="benchmark-card">
          <div class="benchmark-icon benchmark-icon--teal">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
          </div>
          <h3>TFA-Abreicherung & Gegenionen</h3>
          <p>Trifluoressigsäure (TFA) wirkt in Zellkulturen zytotoxisch. Wir bieten Acetat- oder Hydrochlorid-Formulierungen mit minimiertem Gegenionengehalt.</p>
          <span class="benchmark-tag">Minimierte Zytotoxizität</span>
        </div>

        <div class="benchmark-card">
          <div class="benchmark-icon benchmark-icon--indigo">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          </div>
          <h3>Massenspektrometrie (ESI-MS)</h3>
          <p>Exakter Nachweis des Molekulargewichts auf ±0,5 Da zur Ausscheidung von Oxidationsartefakten (+16 Da) oder ungewollten Zyklisierungen.</p>
          <span class="benchmark-tag">Molekulare Exaktheit</span>
        </div>

        <div class="benchmark-card">
          <div class="benchmark-icon benchmark-icon--green">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
          </div>
          <h3>Auditierbare Chargen-COAs</h3>
          <p>Jeder Lieferung liegt das originäre Analysezertifikat mit echten Chromatogrammen bei. Jederzeit digital über unsere COA-Datenbank validierbar.</p>
          <span class="benchmark-tag">100 % Rückverfolgbarkeit</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 4 · STORY: how a lot gets from synthesis to the bench --------------- -->
  <section class="section" aria-labelledby="story-title">
    <div class="container">
      <div class="band-head band-head--stacked">
        <div>
          <h2 id="story-title" class="band-title">{t('home.storyTitle')}</h2>
          <p class="band-lead">{t('home.storyLead')}</p>
        </div>
      </div>

      <ol class="story">
        {storySteps.map((step) => (
          <li class="story__step">
            <span class="story__index" aria-hidden="true">{step.n}</span>
            <span class="story__label">{t('home.storyStep', { n: step.n })}</span>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 5 · PROOF: the certificate, and what is on it ------------------------ -->
  <section class="section surface-soft" id="certificate" aria-labelledby="certificate-title">
    <div class="container">
      <div class="proof">
        <div class="proof__copy">
          <h2 id="certificate-title" class="band-title">{t('home.proofTitle')}</h2>
          <p class="band-lead">{t('home.proofLead')}</p>
          <ul class="proof__list">
            <li>{t('home.proofBullet1')}</li>
            <li>{t('home.proofBullet2')}</li>
            <li>{t('home.proofBullet3')}</li>
            <li>{t('home.proofBullet4')}</li>
          </ul>
          <div class="hero-actions">
            {sampleCoaSlug && (
              <a class="btn btn-primary" href={`/coa/${sampleCoaSlug}${coaSuffix}.html`} target="_blank" rel="noopener">
                {t('home.proofPrimary')}
              </a>
            )}
            <a class={`btn ${sampleCoaSlug ? 'btn-secondary' : 'btn-primary'}`} href={href('/coa-policy/')}>
              {t('home.proofSecondary')}
            </a>
          </div>
        </div>

        <figure class="coa-sketch" aria-label={t('home.proofFigureAlt')}>
          <div class="coa-sketch__head">
            <span class="coa-sketch__brand">PEPTIDE SHOP · ANALYSENZERTIFIKAT</span>
            <span class="coa-sketch__doc">Ph. Eur. Methodik</span>
          </div>
          <div class="coa-sketch__meta">
            <span><em>Produkt</em><i style="width:90%">BPC-157 Lyophilisiert 5 mg</i></span>
            <span><em>Lot-Nummer</em><i style="width:75%">#DE-2026-948B</i></span>
            <span><em>Analysedatum</em><i style="width:60%">2026-03-12</i></span>
            <span><em>Retest-Datum</em><i style="width:60%">2028-03-12 (-20 °C)</i></span>
          </div>
          <table class="coa-sketch__table">
            <thead><tr><th>Parameter</th><th>Prüfmethode</th><th>Soll-Wert</th><th>Befund</th></tr></thead>
            <tbody>
              <tr><td>Aussehen</td><td>Visuell</td><td>Weißes Lyophilisat</td><td style="color:var(--color-accent); font-weight:600;">Entspricht</td></tr>
              <tr><td>Identität</td><td>ESI-MS</td><td>1419.53 ± 1.0 Da</td><td style="color:var(--color-accent); font-weight:600;">1419.5 Da</td></tr>
              <tr><td>Reinheit</td><td>RP-HPLC (220 nm)</td><td>≥ 98.0 %</td><td style="color:var(--color-accent); font-weight:700;">99.4 %</td></tr>
              <tr><td>Wassergehalt</td><td>Karl-Fischer</td><td>≤ 5.0 %</td><td style="color:var(--color-accent); font-weight:600;">3.1 %</td></tr>
              <tr><td>Endotoxine</td><td>LAL Kinetic</td><td>≤ 0.05 EU/mg</td><td style="color:var(--color-accent); font-weight:600;">&lt; 0.01 EU/mg</td></tr>
            </tbody>
          </table>
          <div class="coa-sketch__sign">
            <span><i>Dr. M. Lindner</i><em>Leitung Qualitätskontrolle</em></span>
            <span><i>Freigegeben</i><em>Laboratoriumsfreigabe</em></span>
          </div>
        </figure>
      </div>
    </div>
  </section>

  <!-- 6 · APPLICATIONS ----------------------------------------------------- -->
  <section class="section" aria-labelledby="use-cases-title">
    <div class="container">
      <div class="band-head">
        <div>
          <h2 id="use-cases-title" class="band-title">{t('home.useCasesTitle')}</h2>
        </div>
      </div>
      <div class="goal-row">
        {useCases.map((useCase) => (
          <a class="goal" href={href(`/use-case/${useCase.slug}/`)}>
            <span>{t(`taxonomy.useCases.${useCase.slug}.name`)}</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 6.5 · LAB TOOLS & BUNDLES ---------------------------------------------- -->
  <section class="section" aria-labelledby="tools-title" style="padding-top: var(--space-4);">
    <div class="container">
      <div class="band-head">
        <div>
          <h2 id="tools-title" class="band-title">Präzision von der Vorbereitung bis zur Logistik</h2>
          <p class="band-lead">Wissenschaftliche Werkzeuge und abgestimmte Peptid-Kombinationen für verlässliche In-vitro-Versuchsreihen.</p>
        </div>
      </div>

      <div class="grid grid-3" style="margin-top: var(--space-8);">
        <div class="card" style="display: flex; flex-direction: column; justify-content: space-between; border: 1px solid var(--color-border); background: #ffffff; padding: 1.75rem; border-radius: var(--radius-lg);">
          <div>
            <h3 style="margin: 0 0 0.5rem; font-size: 1.25rem;">Peptid- und Dosierungsrechner</h3>
            <p style="font-size: 0.9rem; color: var(--color-ink-2); line-height: 1.5; margin-bottom: 1.5rem;">
              Berechnen Sie das Mischverhältnis mit sterilem Wasser (BAC), die gewünschte Dosis in Mikrogramm sowie die entsprechenden Teilstriche gängiger Insulinspritzen (U-100 und U-50).
            </p>
          </div>
          <a href={href('/peptid-rechner/')} class="btn btn-primary btn-block">
            Peptid-Rechner öffnen →
          </a>
        </div>

        <div class="card" style="display: flex; flex-direction: column; justify-content: space-between; border: 1px solid var(--color-border); background: #ffffff; padding: 1.75rem; border-radius: var(--radius-lg);">
          <div>
            <h3 style="margin: 0 0 0.5rem; font-size: 1.25rem;">Forschungs-Bundles</h3>
            <p style="font-size: 0.9rem; color: var(--color-ink-2); line-height: 1.5; margin-bottom: 1.5rem;">
              Häufig kombinierte Referenzsubstanzen (wie BPC-157 und TB-500) inklusive bakteriostatischem Wasser als praktisches Set mit 15 % Preisvorteil.
            </p>
          </div>
          <a href={href('/bundles/')} class="btn btn-secondary btn-block">
            Forschungs-Sets ansehen →
          </a>
        </div>

        <div class="card" style="display: flex; flex-direction: column; justify-content: space-between; border: 1px solid var(--color-border); background: #ffffff; padding: 1.75rem; border-radius: var(--radius-lg);">
          <div>
            <h3 style="margin: 0 0 0.5rem; font-size: 1.25rem;">Versand in die DACH-Region</h3>
            <p style="font-size: 0.9rem; color: var(--color-ink-2); line-height: 1.5; margin-bottom: 1.25rem;">
              Zuverlässiger Expressversand: 1 bis 2 Werktage innerhalb Deutschlands, 2 bis 3 Werktage zollfrei nach Österreich sowie koordinierter Priority-Versand in die Schweiz.
            </p>
          </div>
          <div style="display: flex; flex-direction: column; gap: var(--space-2);">
            <a href={href('/shipping/')} class="btn btn-primary btn-block">
              Expressversand DACH (24–48 h) →
            </a>
            <div style="display: flex; gap: 8px;">
              <a href={href('/versand-oesterreich/')} class="btn btn-ghost btn-sm" style="flex: 1; text-align: center; border: 1px solid var(--color-border); font-size: 12px; padding: 6px;">
                Österreich 🇦🇹
              </a>
              <a href={href('/versand-schweiz/')} class="btn btn-ghost btn-sm" style="flex: 1; text-align: center; border: 1px solid var(--color-border); font-size: 12px; padding: 6px;">
                Schweiz 🇨🇭
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 7 · ORDERING: remove the last unknowns before checkout -------------- -->
  <section class="section" aria-labelledby="ordering-title">
    <div class="container">
      <div class="band-head">
        <div>
          <h2 id="ordering-title" class="band-title">{t('home.orderingTitle')}</h2>
        </div>
        <a class="btn btn-secondary" href={href('/shipping/')}>{t('support.shipping')}</a>
      </div>
      <div class="grid grid-4 fact-row">
        {orderFacts.map((fact) => (
          <div class="fact-card">
            <strong>{fact.title}</strong>
            <p>{fact.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 8 · FAQ -------------------------------------------------------------- -->
  <section class="section surface-soft" aria-labelledby="faq-title">
    <div class="container">
      <div class="band-head">
        <div>
          <h2 id="faq-title" class="band-title">{t('home.faqTitle')}</h2>
        </div>
        <a class="btn btn-secondary" href={href('/faq/')}>{t('home.faqAction')}</a>
      </div>
      <div class="faq-list">
        {homeFaqs.map((faq, index) => (
          <details class="faq-item" open={index === 0}>
            <summary>{faq.q}</summary>
            <p>{faq.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 9 · CLOSE ------------------------------------------------------------ -->
  <section class="section">
    <div class="container">
      <div class="cta-band display-typography">
        <h2>{t('home.ctaTitle')}</h2>
        <p>{t('home.ctaBody', { count: totalProducts })}</p>
        <div class="hero-actions">
          <a class="btn btn-primary btn-lg" href={href('/shop/')}>{t('home.ctaPrimary')}</a>
          <a class="btn btn-secondary btn-lg" href={href('/contact/')}>{t('home.ctaSecondary')}</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .newsletter-status {
    margin: var(--space-5) 0 0;
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-primary);
    background: var(--color-primary-50);
    color: var(--color-ink);
    font-weight: 500;
  }
  .newsletter-status--problem {
    border-color: var(--color-warning);
    background: #FEF6E7;
  }

  /* --- 1 · Hero: Centralized Showcase with Background Image -------------- */
  .hero-shot {
    position: relative;
    isolation: isolate;
    background-image: url('/images/site/peptide-kaufen.webp');
    background-size: cover;
    background-position: center 35%;
    color: #fff;
    overflow: hidden;
