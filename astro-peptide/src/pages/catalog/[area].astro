---
import Layout from '../../layouts/Layout.astro';
import JsonLd from '../../components/JsonLd.astro';
import ProductCard from '../../components/ProductCard.astro';
import { toCardProduct } from '../../lib/product';
import Breadcrumb from '../../components/Breadcrumb.astro';
import RUOBanner from '../../components/RUOBanner.astro';
import HubStats from '../../components/HubStats.astro';
import ProductSpecTable from '../../components/ProductSpecTable.astro';
import HubFaq from '../../components/HubFaq.astro';
import { getResearchArea, researchAreas } from '../../data/taxonomy';
import { getCanonicalCollection } from '../../lib/collections';
import { getLocaleFromPathname, localizePath } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import { getLocalizedProduct } from '../../i18n/productContent';

export const prerender = false;

const { area } = Astro.params;
const meta = getResearchArea(area as string);
const locale = (Astro.locals.locale ?? getLocaleFromPathname(Astro.url.pathname));
const t = useTranslations(locale);
const href = (path: string) => localizePath(path, locale);

if (!meta) {
  return Astro.redirect(href('/catalog/'), 301);
}

const areaName = t(`taxonomy.researchAreas.${meta.slug}.name`);
const areaDescription = t(`taxonomy.researchAreas.${meta.slug}.description`);
const areaShort = t(`taxonomy.researchAreas.${meta.slug}.short`);
const areaKeywords = meta.keywords.map((_, index) => t(`taxonomy.researchAreas.${meta.slug}.keywords.${index}`));

const all = await getCanonicalCollection('products');
const products = all
  .filter((p) => p.data.researchArea === area)
  .sort((a, b) => a.data.title.localeCompare(b.data.title));

// The purity floor actually stocked in this area, rather than a site-wide
// boast. Non-numeric grades (e.g. "USP Grade" on the bacteriostatic water)
// are excluded so they cannot drag the figure to nothing.
const purityFloor = Math.min(
  ...products
    .map((entry) => Number(entry.data.purity?.match(/(\d{2,3})\s*%/)?.[1]))
    .filter((value) => Number.isFinite(value)),
  99,
);

const prices = products.map((entry) => entry.data.price).filter((value): value is number => typeof value === 'number');
const fromPrice = prices.length ? Math.min(...prices) : null;

// Sibling hubs. A hub page that only links downward to its own products is a
// dead end for both a reader who guessed the wrong area and a crawler trying
// to reach the other eleven.
const siblingAreas = researchAreas
  .filter((candidate) => candidate.slug !== meta.slug)
  .slice(0, 6);

const url = new URL(Astro.url.pathname, Astro.site).toString();

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListOrder: 'https://schema.org/ItemListOrderAscending',
  numberOfItems: products.length,
  itemListElement: products.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
      url: new URL(href(`/peptides/${p.id}/`), Astro.site).toString(),
      name: getLocalizedProduct(p, locale).title,
  })),
};

const collectionPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: t('catalogArea.schemaName', { area: areaName }),
  description: areaDescription,
  url,
  inLanguage: locale,
};

const breadcrumbs = [
  { name: t('common.home'), url: href('/') },
  { name: t('nav.catalogue'), url: href('/catalog/') },
  { name: areaName, url: href(`/catalog/${meta.slug}/`) },
];
---

<Layout
  title={t('catalogArea.metaTitle', { area: areaName })}
  description={t('catalogArea.metaDescription', { area: areaName, short: areaShort, purity: purityFloor })}
  breadcrumbs={breadcrumbs}
>
  <JsonLd schema={[collectionPageSchema, itemListSchema]} />

  <section class="section">
    <div class="container">
      <Breadcrumb items={breadcrumbs} />

      <h1>{t('catalogArea.title', { area: areaName })}</h1>
      <p class="lead">{areaDescription}</p>

      {products.length > 0 && <HubStats count={products.length} purityFloor={purityFloor} fromPrice={fromPrice} />}

      {products.length === 0 ? (
        <p style="margin-top: var(--space-8); color: var(--color-ink-3);">
          {t('catalogArea.noProducts')} <a href={href('/contact/')}>{t('catalogArea.requestQuote')}</a>.
        </p>
      ) : (
        <div class="grid grid-3" style="margin-top: var(--space-10);">
          {products.map((p) => (
            <ProductCard product={toCardProduct(p, locale)} />
          ))}
        </div>
      )}

      {products.length > 0 && (
        <>
          <ProductSpecTable products={products} />
          <HubFaq group={areaName} purityFloor={purityFloor} />
        </>
      )}

      <RUOBanner heading={t('productPage.ruoHeading')} detail={t('productPage.ruoDetail')} style="margin-top: var(--space-16);" />

      <section class="hub-links" aria-labelledby="other-areas-title">
        <h2 id="other-areas-title">{t('hub.otherAreasTitle')}</h2>
        <div class="hub-links__row">
          {siblingAreas.map((area) => (
            <a class="chip" href={href(`/catalog/${area.slug}/`)}>{t(`taxonomy.researchAreas.${area.slug}.name`)}</a>
          ))}
          <a class="chip" href={href('/catalog/')}>{t('nav.allResearchAreas')}</a>
        </div>
      </section>

      <section class="hub-links" aria-labelledby="related-searches-title">
        <h2 id="related-searches-title">{t('catalogArea.relatedSearches')}</h2>
        <div class="hub-links__row">
          {areaKeywords.map((kw) => (
            <span class="chip" aria-label={t('catalogArea.topicAria', { topic: kw })}>{kw}</span>
          ))}
        </div>
      </section>
    </div>
  </section>
</Layout>

<style>
  .hub-links { margin-top: var(--space-12); }
  .hub-links h2 {
    font-size: var(--text-base);
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--color-ink-3);
    margin: 0 0 var(--space-4);
  }
  .hub-links__row { display: flex; flex-wrap: wrap; gap: var(--space-2); }
</style>
