---
import { getCanonicalCollection } from '../../lib/collections';
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import JsonLd from '../../components/JsonLd.astro';
import ProductOptions from '../../components/ProductOptions';
import ProductCrossSell from '../../components/ProductCrossSell';
import ProductStickyBar from '../../components/ProductStickyBar';
import ProductGallery from '../../components/ProductGallery';
import ProductCard from '../../components/ProductCard.astro';
import { toCardProduct } from '../../lib/product';
import ProductFAQs from '../../components/ProductFAQs.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import RUOBanner from '../../components/RUOBanner.astro';
import TrustBar from '../../components/TrustBar.astro';
import { getResearchArea, useCases, type UseCaseSlug } from '../../data/taxonomy';
import { getLocaleFromPathname, localizePath, localeMeta, sourceLocale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import { getLocalizedProduct } from '../../i18n/productContent';
import { getAvailableLocales, getLocalizedEntry } from '../../lib/localizedEntry';
import { inLanguage } from '../../lib/schema';
import { DEFAULT_LOCALE as DEFAULT_COA_LOCALE, SUPPORTED_LOCALES as SUPPORTED_COA_LOCALES } from '../../lib/coa/i18n';
import entities from '../../data/entities.json';
import { variantsFor, priceRangeFor } from '../../lib/variants';

export const prerender = false;

const { slug: routeSlug } = Astro.params;
const allProductsForLookup = await getCanonicalCollection('products');
const product = allProductsForLookup.find((p) => p.id === routeSlug);
if (!product) {
  return new Response(null, { status: 404 });
}
const { Content } = await render(product);
const locale = (Astro.locals.locale ?? getLocaleFromPathname(Astro.url.pathname));
const t = useTranslations(locale);
const href = (path: string) => localizePath(path, locale);

const currentSlug = product.id;
const availableLocales = await getAvailableLocales('products', currentSlug);

// Per-locale markdown override. When a `<locale>/<slug>.md` exists under
// `src/content/products/`, prefer its frontmatter (title, meta, faqs,
// short_description, storage, price_range) and rendered body for non-English
// locales. Falls back to the runtime helper otherwise.
const localeOverride = locale !== sourceLocale
  ? await getLocalizedEntry('products', currentSlug, locale)
  : undefined;
const hasOverride = !!(localeOverride && localeOverride.id !== currentSlug);
const OverrideContent = hasOverride ? (await render(localeOverride!)).Content : null;

let localizedProduct = getLocalizedProduct(product, locale);
if (hasOverride && localeOverride) {
  const od = localeOverride.data;
  const cleanFromOverride = od.title.split(' — ')[0].split(' – ')[0].trim();
  localizedProduct = {
    ...localizedProduct,
    title: od.title,
    cleanTitle: cleanFromOverride,
    shortDescription: od.short_description,
    storage: od.storage,
    priceRange: od.price_range,
    meta: od.meta,
    faqs: od.faqs ?? [],
  };
}

const cleanTitle = localizedProduct.cleanTitle;
const productImages = (product.data.images?.length ? product.data.images : ['/images/peptide-default.jpg']);
const productImage = productImages[0];
const siteUrl = 'https://peptide-kaufen.net';
const productUrl = `${siteUrl}${href(`/peptides/${currentSlug}/`)}`;
const productImageUrl = productImage.startsWith('http') ? productImage : `${siteUrl}${productImage}`;
const researchArea = product.data.researchArea ? getResearchArea(product.data.researchArea) : undefined;
const researchAreaName = researchArea ? t(`taxonomy.researchAreas.${researchArea.slug}.name`) : undefined;
const productUseCases = (product.data.useCases ?? [])
  .map((useCaseSlug: string) => {
    const useCase = useCases.find((candidate) => candidate.slug === useCaseSlug);
    return useCase ? { slug: useCase.slug, name: t(`taxonomy.useCases.${useCase.slug}.name`) } : undefined;
  })
  .filter((useCase): useCase is { slug: UseCaseSlug; name: string } => Boolean(useCase));
const pageCoaLocale = (SUPPORTED_COA_LOCALES as readonly string[]).includes(locale)
  ? (locale as (typeof SUPPORTED_COA_LOCALES)[number])
  : DEFAULT_COA_LOCALE;
const coaHtmlPath = pageCoaLocale === DEFAULT_COA_LOCALE
  ? `/coa/${currentSlug}.html`
  : `/coa/${currentSlug}.${pageCoaLocale}.html`;
const coaPdfPath = pageCoaLocale === DEFAULT_COA_LOCALE
  ? `/api/coa/${currentSlug}.pdf`
  : `/api/coa/${currentSlug}.pdf?lang=${pageCoaLocale}`;
const alternateCoaLocales = SUPPORTED_COA_LOCALES.filter((coaLocale) => coaLocale !== pageCoaLocale);

const extractPrice = (priceStr: string): number => {
  const match = priceStr?.match(/[\d,]+(?:\.\d+)?/);
  return match ? parseFloat(match[0].replace(',', '')) : 99;
};

const productPrice = product.data.price ?? extractPrice(product.data.price_range);
const variants = variantsFor(product.data);
const variantRange = priceRangeFor(variants);
const hasMultipleVariants = variants.length > 1;
const reviews = product.data.reviews ?? [];
const averageRating = reviews.length > 0
  ? reviews.reduce((sum: number, review: { rating: number }) => sum + review.rating, 0) / reviews.length
  : null;
// Review / AggregateRating are emitted ONLY when genuine, user-sourced reviews
// exist in the product frontmatter. Google's review-snippet policy forbids
// ratings the reviewed entity creates about itself ("Ratings must be sourced
// directly from users"), so a placeholder self-review is never synthesised —
// omitting the optional field is correct; fabricating it risks a structured
// data manual action.
const reviewObjects = reviews.map((review) => ({
  '@type': 'Review',
  author: { '@type': 'Person', name: review.author },
  datePublished: review.date,
  name: review.title,
  reviewBody: review.content,
  reviewRating: {
    '@type': 'Rating',
    ratingValue: String(review.rating),
    bestRating: '5',
    worstRating: '1',
  },
}));
const aggregateRating = reviews.length > 0 && averageRating !== null
  ? {
      '@type': 'AggregateRating',
      ratingValue: averageRating.toFixed(1),
      reviewCount: reviews.length,
      bestRating: '5',
      worstRating: '1',
    }
  : null;
const entityMap = entities as Record<string, { sameAs?: string[]; cas?: string | null; molecularFormula?: string | null; pubchem?: string | null; wikidata?: string | null }>;
const productEntity = entityMap[currentSlug];
const additionalProperties = [
  product.data.cas && { '@type': 'PropertyValue', name: 'CAS Number', value: product.data.cas },
  product.data.molecular_weight && { '@type': 'PropertyValue', name: 'Molecular weight', value: product.data.molecular_weight },
  product.data.purity && { '@type': 'PropertyValue', name: 'Purity', value: product.data.purity },
  productEntity?.molecularFormula && { '@type': 'PropertyValue', name: 'Molecular formula', value: productEntity.molecularFormula },
].filter(Boolean);

const relatedProducts = allProductsForLookup
  .filter((candidate) => candidate.id !== product.id && candidate.data.researchArea === product.data.researchArea)
  .slice(0, 4);

const priceValidUntil = new Date(Date.now() + 365 * 24 * 60 * 60 * 1000).toISOString().slice(0, 10);

/*
 * Delivery and returns are identical for every package size, so they are
 * declared once and attached to each Offer. Google reads them per Offer for
 * merchant listings, so they cannot only live on the AggregateOffer wrapper.
 */
const OFFER_COUNTRIES = ['AT', 'DE', 'CH', 'NL', 'FR', 'IT', 'ES', 'BE', 'PL', 'SE', 'DK', 'FI', 'PT'];
const sharedOfferTerms = {
  priceCurrency: 'EUR',
  priceValidUntil,
  availability: 'https://schema.org/InStock',
  itemCondition: 'https://schema.org/NewCondition',
  seller: {
    '@type': 'Organization',
    name: 'Peptide Shop',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Wien',
      addressCountry: 'AT',
    },
  },
  hasMerchantReturnPolicy: {
    '@type': 'MerchantReturnPolicy',
    applicableCountry: OFFER_COUNTRIES,
    returnPolicyCategory: 'https://schema.org/MerchantReturnFiniteReturnWindow',
    merchantReturnDays: 14,
    returnMethod: 'https://schema.org/ReturnByMail',
    returnFees: 'https://schema.org/FreeReturn',
    refundType: 'https://schema.org/FullRefund',
    merchantReturnLink: 'https://peptide-kaufen.net/terms/#widerruf',
  },
  shippingDetails: [
    {
      '@type': 'OfferShippingDetails',
      shippingDestination: { '@type': 'DefinedRegion', addressCountry: 'AT' },
      shippingRate: { '@type': 'MonetaryAmount', value: '9.90', currency: 'EUR' },
      deliveryTime: {
        '@type': 'ShippingDeliveryTime',
        handlingTime: { '@type': 'QuantitativeValue', minValue: 0, maxValue: 1, unitCode: 'DAY' },
        transitTime: { '@type': 'QuantitativeValue', minValue: 1, maxValue: 2, unitCode: 'DAY' },
      },
    },
    {
      '@type': 'OfferShippingDetails',
      shippingDestination: { '@type': 'DefinedRegion', addressCountry: 'DE' },
      shippingRate: { '@type': 'MonetaryAmount', value: '9.90', currency: 'EUR' },
      deliveryTime: {
        '@type': 'ShippingDeliveryTime',
        handlingTime: { '@type': 'QuantitativeValue', minValue: 0, maxValue: 1, unitCode: 'DAY' },
        transitTime: { '@type': 'QuantitativeValue', minValue: 1, maxValue: 3, unitCode: 'DAY' },
      },
    },
    {
      '@type': 'OfferShippingDetails',
      shippingDestination: { '@type': 'DefinedRegion', addressCountry: 'CH' },
      shippingRate: { '@type': 'MonetaryAmount', value: '14.90', currency: 'EUR' },
      deliveryTime: {
        '@type': 'ShippingDeliveryTime',
        handlingTime: { '@type': 'QuantitativeValue', minValue: 0, maxValue: 1, unitCode: 'DAY' },
        transitTime: { '@type': 'QuantitativeValue', minValue: 2, maxValue: 4, unitCode: 'DAY' },
      },
    },
    {
      '@type': 'OfferShippingDetails',
      shippingDestination: { '@type': 'DefinedRegion', addressCountry: ['NL', 'FR', 'IT', 'ES', 'BE', 'PL', 'SE', 'DK', 'FI', 'PT'] },
      shippingRate: { '@type': 'MonetaryAmount', value: '9.90', currency: 'EUR' },
      deliveryTime: {
        '@type': 'ShippingDeliveryTime',
        handlingTime: { '@type': 'QuantitativeValue', minValue: 0, maxValue: 1, unitCode: 'DAY' },
        transitTime: { '@type': 'QuantitativeValue', minValue: 2, maxValue: 5, unitCode: 'DAY' },
      },
    },
  ],
};

/*
 * One Offer per package size once there is more than one, wrapped in an
 * AggregateOffer whose low/high is what Google renders as the price range. A
 * single Offer can carry only one price, so leaving the shape fixed while the
 * page shows several would put the markup and the page in disagreement — which
 * is a structured-data violation, not just an inaccuracy.
 */
const offerNode = hasMultipleVariants && variantRange
  ? {
      '@type': 'AggregateOffer',
      url: productUrl,
      priceCurrency: 'EUR',
      lowPrice: variantRange.low.toFixed(2),
      highPrice: variantRange.high.toFixed(2),
      offerCount: variants.length,
      offers: variants.map((variant) => ({
        '@type': 'Offer',
        url: productUrl,
        sku: variant.sku,
        name: variant.size,
        price: variant.price.toFixed(2),
        ...sharedOfferTerms,
      })),
    }
  : {
      '@type': 'Offer',
      url: productUrl,
      price: (variants[0]?.price ?? productPrice).toFixed(2),
      ...sharedOfferTerms,
    };

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  inLanguage: inLanguage(locale),
  name: cleanTitle,
  description: localizedProduct.meta.description,
  image: [productImageUrl],
  sku: product.data.id,
  mpn: product.data.id,
  brand: {
    '@type': 'Brand',
    name: 'Peptide Shop',
  },
  category: researchAreaName ?? product.data.category,
  ...(productEntity?.sameAs?.length ? { sameAs: productEntity.sameAs } : {}),
  ...(additionalProperties.length ? { additionalProperty: additionalProperties } : {}),
  offers: offerNode,
  ...(reviewObjects.length ? { review: reviewObjects } : {}),
  ...(aggregateRating ? { aggregateRating } : {}),
};

const faqSchema = localizedProduct.faqs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
    inLanguage: inLanguage(locale),
      mainEntity: localizedProduct.faqs.map((faq: { question: string; answer: string }) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.answer,
        },
      })),
    }
  : null;

const breadcrumbs = [
  { name: t('common.home'), url: href('/') },
  { name: t('productPage.catalogue'), url: href('/catalog/') },
  ...(researchArea && researchAreaName ? [{ name: researchAreaName, url: href(`/catalog/${researchArea.slug}/`) }] : []),
  { name: cleanTitle, url: href(`/peptides/${currentSlug}/`) },
];
---

<Layout
  title={localizedProduct.meta.title}
  description={localizedProduct.meta.description}
  image={productImage}
  breadcrumbs={breadcrumbs}
  availableLocales={availableLocales}
>
  <JsonLd schema={faqSchema ? [productSchema, faqSchema] : productSchema} />

  <section class="product-page section">
    <div class="container">
      <Breadcrumb items={[
        { name: t('common.home'), url: href('/') },
        { name: t('productPage.catalogue'), url: href('/catalog/') },
        ...(researchArea && researchAreaName ? [{ name: researchAreaName, url: href(`/catalog/${researchArea.slug}/`) }] : []),
        { name: cleanTitle },
      ]} />

      {/*
        Above the fold is two columns: image, then buy. The catalogue sidebar,
        the full-width RUO slab and the long spec list previously split this
        row four ways and squeezed the product shot to roughly 250px — the one
        element a shopper actually looks at first. RUO stays visible as a badge
        here and in the buy box, with the full statement kept further down.
      */}
      <div class="pdp">
        <div class="pdp__media">
          <ProductGallery
            client:load
            images={productImages}
            alt={t('productPage.imageAlt', { product: cleanTitle })}
            labels={{
              zoomHint: t('productPage.zoomHint'),
              close: t('productPage.closeViewer'),
              previous: t('productPage.previousImage'),
              next: t('productPage.nextImage'),
              viewLarger: t('productPage.viewLarger'),
              thumbnailFor: t('productPage.thumbnailFor'),
            }}
          />
        </div>

        <div class="pdp__info">
          <div class="pdp__header-meta">
            <span class="pdp-status-pill">
              <span class="pdp-status-dot"></span>
              <span>Auf Lager · Versandbereit in 24h</span>
            </span>
            {researchArea && (
              <a href={href(`/catalog/${researchArea.slug}/`)} class="pdp-category-pill">
                {researchAreaName ?? researchArea.name}
              </a>
            )}
          </div>

          <h1 class="pdp__title">{cleanTitle}</h1>

          <div class="pdp__badges" aria-label={t('productPage.qualityBadges')}>
            <span class="pdp-badge pdp-badge--purity">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              <span>{product.data.purity} Reinheit (HPLC)</span>
            </span>
            <span class="pdp-badge pdp-badge--coa">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
              <span>{t('productPage.coaSupported')}</span>
            </span>
            <span class="pdp-badge pdp-badge--form">Lyophilisiertes Pulver</span>
            <span class="pdp-badge pdp-badge--ruo">RUO Laborstandard</span>
          </div>

          <aside id="pdp-buy-box" class="buy-box card" aria-label={t('productPage.purchaseOptions')}>
            <ProductOptions
              client:load
              id={product.data.id}
              title={localizedProduct.title}
              basePrice={variants[0]?.price ?? productPrice}
              packageSizes={product.data.package_sizes}
              variants={variants}
              moq={product.data.moq}
              image={productImage}
              category={product.data.category}
              labels={{
                price: t('productOptions.price'),
                perVial: t('productOptions.perVial'),
                defaultPackage: t('productOptions.defaultPackage'),
                quantity: t('productOptions.quantity'),
                selectQuantity: t('productOptions.selectQuantity'),
                decreaseQuantity: t('productOptions.decreaseQuantity'),
                increaseQuantity: t('productOptions.increaseQuantity'),
                orderSummary: t('productOptions.orderSummary'),
                subtotal: t('productOptions.subtotal'),
                delivery: t('productOptions.delivery'),
                free: t('productOptions.free'),
                calculatedAtCheckout: t('productOptions.calculatedAtCheckout'),
                addToCart: t('cartActions.addToCart'),
                addedToCart: t('cartActions.addedToCart'),
                minimumNote: t('productOptions.minimumNote'),
                ruoNote: t('productOptions.ruoNote'),
                size: t('productOptions.size'),
                selectSize: t('productOptions.selectSize'),
                saveVsSmallest: t.raw('productOptions.saveVsSmallest'),
              }}
            />
          </aside>

          {/* Scientific Specification Tiles */}
          <dl class="fact-grid">
            {product.data.cas && (
              <div class="fact">
                <dt>CAS-Nummer</dt>
                <dd class="text-mono">{product.data.cas}</dd>
              </div>
            )}
            {product.data.molecular_weight && (
              <div class="fact">
                <dt>{t('productPage.molecularWeight')}</dt>
                <dd class="text-mono">{product.data.molecular_weight}</dd>
              </div>
            )}
            <div class="fact">
              <dt>{t('productPage.packageSizes')}</dt>
              <dd>{(hasMultipleVariants ? variants.map((variant) => variant.size) : product.data.package_sizes).join(', ')}</dd>
            </div>
            <div class="fact">
              <dt>{t('productPage.storage')}</dt>
              <dd>{localizedProduct.storage.split('(')[0].trim()}</dd>
            </div>
          </dl>

          <div class="hub-links">
            {researchArea && <a class="chip" href={href(`/catalog/${researchArea.slug}/`)}>{researchAreaName ?? researchArea.name}</a>}
            {productUseCases.map((useCase) => useCase && (
              <a class="chip" href={href(`/use-case/${useCase.slug}/`)}>{t(`taxonomy.useCases.${useCase.slug}.name`)}</a>
            ))}
          </div>
        </div>
      </div>

      <ProductCrossSell
        client:load
        currentProductId={product.data.id}
        currentProductTitle={cleanTitle}
        currentProductPrice={variants[0]?.price ?? productPrice}
        currentProductImage={productImage}
      />

      <TrustBar tone="light" class="pdp-trust" />

      {/* Laboratory Documentation Hub */}
      <div class="pdp-detail">
        <details class="disclose" id="description" open>
          <summary>
            <div class="disclose__title-group">
              <span class="disclose__icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 18h8"/><path d="M3 22h18"/><path d="M14 22a7 7 0 1 0 0-14h-1"/><path d="M9 14h2"/><path d="M9 12a2 2 0 0 1 2-2h1"/><path d="M14 8V3a1 1 0 0 0-1-1h-2a1 1 0 0 0-1 1v5"/></svg>
              </span>
              <span>{t('productPage.description')}</span>
            </div>
          </summary>
          <div class="disclose__body prose-content">
            {locale === sourceLocale ? <Content /> : (OverrideContent ? <OverrideContent /> : <Fragment set:html={localizedProduct.bodyHtml} />)}
          </div>
        </details>

        <details class="disclose" id="data">
          <summary>
            <div class="disclose__title-group">
              <span class="disclose__icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
              </span>
              <span>{t('productPage.sequenceData')}</span>
            </div>
          </summary>
          <div class="disclose__body">
            <table class="table-clean">
              <tbody>
                <tr><th scope="row">{t('productPage.productId')}</th><td class="text-mono">{product.data.id}</td></tr>
                <tr><th scope="row">CAS</th><td class="text-mono">{product.data.cas ?? t('productPage.notAssigned')}</td></tr>
                <tr><th scope="row">{t('productPage.molecularWeight')}</th><td class="text-mono">{product.data.molecular_weight ?? t('productPage.notAssigned')}</td></tr>
                <tr><th scope="row">{t('productPage.purity')}</th><td><strong class="text-success">{product.data.purity} (HPLC)</strong></td></tr>
                {productEntity?.molecularFormula && <tr><th scope="row">Summenformel</th><td class="text-mono">{productEntity.molecularFormula}</td></tr>}
                {product.data.sequence && <tr><th scope="row">{t('productPage.sequence')}</th><td class="text-mono">{product.data.sequence}</td></tr>}
              </tbody>
            </table>
          </div>
        </details>

        <details class="disclose" id="storage">
          <summary>
            <div class="disclose__title-group">
              <span class="disclose__icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 2v7.527a2 2 0 0 1-.211.896L4.72 20.55a1 1 0 0 0 .9 1.45h12.76a1 1 0 0 0 .9-1.45l-5.069-10.127A2 2 0 0 1 14 9.527V2"/><path d="M8.5 2h7"/><path d="M7 16h10"/></svg>
              </span>
              <span>{t('productPage.storageHandling')}</span>
            </div>
          </summary>
          <div class="disclose__body">
            <p>{localizedProduct.storage}</p>
            <p>{t('productPage.storageHandlingBody')}</p>

            <div class="sop-protocol-box">
              <div class="sop-header">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0077B6" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
                <strong>Labor-Standardarbeitsanweisung (SOP) zur Rekonstitution</strong>
              </div>
              <ol class="sop-steps">
                <li><strong>Temperierung:</strong> Vial und Diluent vor dem Lösen 10–15 Minuten bei kontrollierter Raumtemperatur (20–25 °C) akklimatisieren lassen. Septum mit 70 % Isopropanol desinfizieren.</li>
                <li><strong>Rekonstitution:</strong> Ausschließlich <a href={href('/peptides/bacteriostatic-water/')}>bakteriostatisches Wasser (30 ml)</a> oder steriles Wasser für Injektionszwecke verwenden. Den Diluent-Strahl langsam an der Glasinnenwand herunterlaufen lassen (nicht direkt auf den Peptidkuchen richten).</li>
                <li><strong>Lösungsvorgang:</strong> Fläschchen vorsichtig mit leicht kreisenden Bewegungen schwenken, bis eine optisch klare Lösung vorliegt. Niemals schütteln oder vortexen, um Scherbelastung und Denaturierung zu verhindern.</li>
                <li><strong>Lagerung der Lösung:</strong> Rekonstituiertes Peptid stets bei 2 °C bis 8 °C lagern und innerhalb von 28 Tagen im Forschungsversuch verbrauchen. Vor Licht und wiederholtem Einfrieren/Auftauen schützen.</li>
              </ol>
              <div class="sop-footer">
                <span>Berechnen Sie das exakte Mischverhältnis für Ihre Laboreinheiten:</span>
                <a href={href('/peptid-rechner/')} class="sop-calc-btn">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="8" y1="6" x2="16" y2="6"/><line x1="16" y1="14" x2="16" y2="18"/><path d="M16 10h.01"/><path d="M12 10h.01"/><path d="M8 10h.01"/><path d="M12 14h.01"/><path d="M8 14h.01"/><path d="M12 18h.01"/><path d="M8 18h.01"/></svg>
                  <span>Zum Peptid-Dosierungsrechner →</span>
                </a>
              </div>
            </div>
          </div>
        </details>

        <details class="disclose" id="coa">
          <summary>
            <div class="disclose__title-group">
              <span class="disclose__icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
              </span>
              <span>{t('productPage.certificate')}</span>
            </div>
          </summary>
          <div class="disclose__body">
            <div class="coa-card">
              <div class="coa-card__info">
                <span class="coa-card__badge">Chargenbezogene Qualitätskontrolle</span>
                <h4 class="coa-card__title">Analysenzertifikat (COA) für {cleanTitle}</h4>
                <p class="coa-card__desc">
                  Jede Charge wird vor Freigabe durch unabhängige Hochleistungsflüssigkeitschromatographie (HPLC) und Massenspektrometrie (MS) auf Reinheit (≥{product.data.purity}), Identität und Gehalt geprüft.
                </p>
              </div>

              <div class="coa-actions">
                <a class="btn btn-primary btn-coa" href={coaPdfPath} download>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                  <span>{t('productPage.downloadCoa')} (PDF)</span>
                </a>
                <a class="btn btn-secondary btn-coa" href={coaHtmlPath} target="_blank" rel="noopener">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                  <span>{t('productPage.previewHtml')}</span>
                </a>
                <a class="btn btn-ghost" href={href('/coa-policy/')}>{t('productPage.coaPolicy')}</a>
              </div>

              <details class="coa-langs">
                <summary>{t('productPage.otherLanguages')}</summary>
                <ul>
                  {alternateCoaLocales.map((coaLocale) => (
                    <li><a href={`/api/coa/${currentSlug}.pdf?lang=${coaLocale}`} download>{localeMeta[coaLocale]?.name ?? coaLocale.toUpperCase()} (PDF)</a> · <a href={`/coa/${currentSlug}.${coaLocale}.html`} target="_blank" rel="noopener">HTML</a></li>
                  ))}
                </ul>
              </details>
            </div>
          </div>
        </details>

        {localizedProduct.faqs.length > 0 && (
          <details class="disclose" id="faqs">
            <summary>
              <div class="disclose__title-group">
                <span class="disclose__icon">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                </span>
                <span>{t('productPage.faqs')}</span>
              </div>
            </summary>
            <div class="disclose__body">
              <ProductFAQs productName={cleanTitle} faqs={localizedProduct.faqs} heading="" />
            </div>
          </details>
        )}
      </div>

      {/* Full research-use statement, kept on the page for compliance. */}
      <RUOBanner
        heading={t('productPage.ruoHeading')}
        detail={t('productPage.ruoDetail')}
      />

      {relatedProducts.length > 0 && (
        <section class="section related-section" aria-labelledby="related-title">
          <h2 id="related-title">{t('productPage.relatedTitle', { area: researchAreaName ?? t('productPage.relatedFallbackArea') })}</h2>
          <div class="grid grid-4" style="margin-top: var(--space-8);">
            {relatedProducts.map((related) => (
              <ProductCard product={toCardProduct(related, locale)} />
            ))}
          </div>
        </section>
      )}
    </div>
  </section>

  <ProductStickyBar
    client:idle
    id={product.data.id}
    title={cleanTitle}
    price={variants[0]?.price ?? productPrice}
    image={productImage}
    packageSize={variants[0]?.size ?? product.data.package_sizes[0] ?? '1 Vial'}
    variants={variants}
  />
</Layout>

<style>
  .product-page { padding-top: var(--space-8); padding-bottom: var(--space-16); }

  /* Two columns: the media gets a balanced share, buy box stays comfortably wide */
  .pdp {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(380px, 460px);
    gap: clamp(var(--space-6), 4vw, var(--space-12));
    align-items: start;
    margin-top: var(--space-6);
  }
  .pdp__media { position: sticky; top: 96px; min-width: 0; }
  .pdp__info { min-width: 0; display: flex; flex-direction: column; gap: var(--space-4); }

  /* Eyebrow & Status Row */
  .pdp__header-meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  .pdp-status-pill {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: #047857;
    background: #ECFDF5;
    border: 1px solid #A7F3D0;
    padding: 3px 10px;
    border-radius: 999px;
    letter-spacing: -0.01em;
  }
  .pdp-status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: #059669;
    box-shadow: 0 0 0 2px rgba(5, 150, 105, 0.2);
    animation: pdp-pulse 2s infinite ease-in-out;
  }
  @keyframes pdp-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.55; transform: scale(0.85); }
  }
  .pdp-category-pill {
    display: inline-flex;
    align-items: center;
    font-size: 0.8125rem;
    font-weight: 550;
    color: var(--color-ink-3);
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    padding: 3px 10px;
    border-radius: 999px;
    text-decoration: none;
    transition: all 0.15s ease;
  }
  .pdp-category-pill:hover {
    color: var(--color-primary);
    border-color: var(--color-primary-100);
    background: #EFF8FC;
  }

  .pdp__title {
    margin: 0;
    font-size: clamp(2rem, 1.3rem + 2.2vw, 2.85rem);
    line-height: 1.12;
    letter-spacing: -0.03em;
    font-weight: 800;
    color: var(--color-ink);
    font-family: var(--font-display);
  }

  /* Laboratory Verification & Standard Badges */
  .pdp__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }
  .pdp-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 6px;
    letter-spacing: -0.01em;
  }
  .pdp-badge--purity {
    background: #ECFDF5;
    color: #047857;
    border: 1px solid #A7F3D0;
  }
  .pdp-badge--coa {
    background: #EFF8FC;
    color: #015BA0;
    border: 1px solid #BAE3F7;
  }
  .pdp-badge--form {
    background: var(--color-surface-2);
    color: var(--color-ink-2);
    border: 1px solid var(--color-border);
  }
  .pdp-badge--ruo {
    background: #FFFBEB;
    color: #B45309;
    border: 1px solid #FDE68A;
    font-weight: 700;
  }

  /* Buy Box Card Container */
  .buy-box.card {
    background: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl, 16px);
    padding: clamp(var(--space-4), 3vw, var(--space-6));
    box-shadow: 0 4px 20px -2px rgba(15, 23, 42, 0.05), 0 2px 6px -1px rgba(15, 23, 42, 0.03);
    margin-top: 2px;
  }

  /* Fact Grid: Clinical Laboratory Data Tiles */
  .fact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: var(--space-2);
    margin: 0;
  }
  .fact {
    padding: var(--space-3) var(--space-4);
    background: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md, 12px);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .fact:hover {
    border-color: var(--color-border-strong);
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
  }
  .fact dt {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--color-ink-3);
    font-weight: 650;
    margin-bottom: 2px;
  }
  .fact dd {
    margin: 0;
    font-weight: 700;
    color: var(--color-ink);
    font-size: 0.875rem;
    line-height: 1.35;
  }
  .text-mono {
    font-family: var(--font-mono);
    letter-spacing: -0.01em;
  }

  .hub-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  /* Executive Laboratory Documentation Hub */
  .pdp-detail {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-12);
  }
  .disclose {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg, 16px);
    background: #FFFFFF;
    overflow: hidden;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .disclose:hover {
    border-color: var(--color-border-strong);
  }
  .disclose[open] {
    box-shadow: 0 4px 16px -2px rgba(15, 23, 42, 0.05);
    border-color: #CBD5E1;
  }
  .disclose > summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    cursor: pointer;
    font-weight: 700;
    font-size: var(--text-lg);
    list-style: none;
    transition: background 0.15s ease;
    user-select: none;
  }
  .disclose > summary::-webkit-details-marker { display: none; }
  .disclose > summary:hover { background: var(--color-surface-2); }
  .disclose__title-group {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-ink);
  }
  .disclose__icon {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: var(--color-surface-2);
    color: var(--color-primary);
    flex-shrink: 0;
  }
  .disclose > summary::after {
    content: '';
    flex: none;
    width: 9px;
    height: 9px;
    border-right: 2px solid var(--color-ink-3);
    border-bottom: 2px solid var(--color-ink-3);
    transform: rotate(45deg) translate(-2px, -2px);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .disclose[open] > summary::after {
    transform: rotate(-135deg) translate(-2px, -2px);
  }
  .disclose[open] > summary {
    border-bottom: 1px solid var(--color-border);
    background: #FBFDFF;
  }
  .disclose__body {
    padding: clamp(var(--space-4), 3vw, var(--space-6));
    color: var(--color-ink-2);
    line-height: 1.65;
  }
  .disclose__body > :first-child { margin-top: 0; }

  /* SOP Reconstitution Protocol Card */
  .sop-protocol-box {
    margin-top: var(--space-5);
    padding: var(--space-5);
    background: #F8FAFC;
    border-radius: var(--radius-md, 12px);
    border: 1px solid var(--color-border);
  }
  .sop-header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-ink);
    font-size: 0.9375rem;
    margin-bottom: var(--space-3);
  }
  .sop-steps {
    margin: 0 0 var(--space-4);
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 0.875rem;
    color: var(--color-ink-2);
  }
  .sop-steps li strong {
    color: var(--color-ink);
  }
  .sop-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
    font-size: 0.8125rem;
    color: var(--color-ink-3);
  }
  .sop-calc-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 650;
    color: var(--color-primary);
    background: #EFF8FC;
    border: 1px solid #BAE3F7;
    padding: 6px 12px;
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.15s ease;
  }
  .sop-calc-btn:hover {
    background: #D6EEF8;
    color: var(--color-primary-600);
  }

  /* COA Analytical Card */
  .coa-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .coa-card__badge {
    display: inline-block;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #047857;
    background: #ECFDF5;
    padding: 2px 8px;
    border-radius: 4px;
    margin-bottom: 6px;
  }
  .coa-card__title {
    margin: 0 0 6px;
    font-size: 1.125rem;
    color: var(--color-ink);
  }
  .coa-card__desc {
    margin: 0;
    font-size: 0.875rem;
    color: var(--color-ink-2);
  }
  .coa-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .btn-coa {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .coa-langs {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-ink-2);
  }
  .coa-langs summary { cursor: pointer; color: var(--color-primary); font-weight: 600; }
  .coa-langs ul { margin: var(--space-3) 0 0; padding-left: var(--space-5); display: grid; gap: var(--space-2); }
  .coa-langs a { color: var(--color-primary); text-decoration: none; }
  .coa-langs a:hover { text-decoration: underline; }

  .prose-content :global(h2),
  .prose-content :global(h3) { margin-top: var(--space-6); color: var(--color-ink); }
  .prose-content :global(p) { color: var(--color-ink-2); line-height: 1.65; }
  .related-section { padding-bottom: 0; }

  @media (max-width: 960px) {
    .pdp { grid-template-columns: 1fr; }
    .pdp__media { position: static; }
  }
  @media (prefers-reduced-motion: reduce) {
    .disclose > summary,
    .disclose > summary::after { transition: none; }
  }
</style>

<style is:global>
