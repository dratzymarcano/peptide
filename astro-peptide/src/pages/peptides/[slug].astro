---
import { getCanonicalCollection } from '../../lib/collections';
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import JsonLd from '../../components/JsonLd.astro';
import ProductOptions from '../../components/ProductOptions';
import ProductGallery from '../../components/ProductGallery';
import ProductCard from '../../components/ProductCard.astro';
import { toCardProduct } from '../../lib/product';
import ProductFAQs from '../../components/ProductFAQs.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import RUOBanner from '../../components/RUOBanner.astro';
import { getResearchArea, useCases, type UseCaseSlug } from '../../data/taxonomy';
import { getLocaleFromPathname, localizePath, localeMeta } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import { getLocalizedProduct } from '../../i18n/productContent';
import { getAvailableLocales, getLocalizedEntry } from '../../lib/localizedEntry';
import { inLanguage } from '../../lib/schema';
import { DEFAULT_LOCALE as DEFAULT_COA_LOCALE, SUPPORTED_LOCALES as SUPPORTED_COA_LOCALES } from '../../lib/coa/i18n';
import entities from '../../data/entities.json';

export const prerender = false;

const { slug: routeSlug } = Astro.params;
const allProductsForLookup = await getCanonicalCollection('products');
const product = allProductsForLookup.find((p) => p.id === routeSlug);
if (!product) {
  return new Response(null, { status: 404 });
}
const { Content } = await render(product);
const locale = (Astro.locals.locale ?? getLocaleFromPathname(Astro.url.pathname));
const t = useTranslations(locale);
const href = (path: string) => localizePath(path, locale);

const currentSlug = product.id;
const availableLocales = await getAvailableLocales('products', currentSlug);

// Per-locale markdown override. When a `<locale>/<slug>.md` exists under
// `src/content/products/`, prefer its frontmatter (title, meta, faqs,
// short_description, storage, price_range) and rendered body for non-English
// locales. Falls back to the runtime helper otherwise.
const localeOverride = locale !== 'en'
  ? await getLocalizedEntry('products', currentSlug, locale)
  : undefined;
const hasOverride = !!(localeOverride && localeOverride.id !== currentSlug);
const OverrideContent = hasOverride ? (await render(localeOverride!)).Content : null;

let localizedProduct = getLocalizedProduct(product, locale);
if (hasOverride && localeOverride) {
  const od = localeOverride.data;
  const cleanFromOverride = od.title.split(' — ')[0].split(' – ')[0].trim();
  localizedProduct = {
    ...localizedProduct,
    title: od.title,
    cleanTitle: cleanFromOverride,
    shortDescription: od.short_description,
    storage: od.storage,
    priceRange: od.price_range,
    meta: od.meta,
    faqs: od.faqs ?? [],
  };
}

const cleanTitle = localizedProduct.cleanTitle;
const productImages = (product.data.images?.length ? product.data.images : ['/images/peptide-default.jpg']);
const productImage = productImages[0];
const siteUrl = 'https://peptide-kaufen.net';
const productUrl = `${siteUrl}${href(`/peptides/${currentSlug}/`)}`;
const productImageUrl = productImage.startsWith('http') ? productImage : `${siteUrl}${productImage}`;
const researchArea = product.data.researchArea ? getResearchArea(product.data.researchArea) : undefined;
const researchAreaName = researchArea ? t(`taxonomy.researchAreas.${researchArea.slug}.name`) : undefined;
const productUseCases = (product.data.useCases ?? [])
  .map((useCaseSlug: string) => {
    const useCase = useCases.find((candidate) => candidate.slug === useCaseSlug);
    return useCase ? { slug: useCase.slug, name: t(`taxonomy.useCases.${useCase.slug}.name`) } : undefined;
  })
  .filter((useCase): useCase is { slug: UseCaseSlug; name: string } => Boolean(useCase));
const alternateCoaLocales = SUPPORTED_COA_LOCALES.filter((coaLocale) => coaLocale !== DEFAULT_COA_LOCALE);

const extractPrice = (priceStr: string): number => {
  const match = priceStr?.match(/[\d,]+(?:\.\d+)?/);
  return match ? parseFloat(match[0].replace(',', '')) : 99;
};

const productPrice = product.data.price ?? extractPrice(product.data.price_range);
const reviews = product.data.reviews ?? [];
const averageRating = reviews.length > 0
  ? reviews.reduce((sum: number, review: { rating: number }) => sum + review.rating, 0) / reviews.length
  : null;
// Review / AggregateRating are emitted ONLY when genuine, user-sourced reviews
// exist in the product frontmatter. Google's review-snippet policy forbids
// ratings the reviewed entity creates about itself ("Ratings must be sourced
// directly from users"), so a placeholder self-review is never synthesised —
// omitting the optional field is correct; fabricating it risks a structured
// data manual action.
const reviewObjects = reviews.map((review) => ({
  '@type': 'Review',
  author: { '@type': 'Person', name: review.author },
  datePublished: review.date,
  name: review.title,
  reviewBody: review.content,
  reviewRating: {
    '@type': 'Rating',
    ratingValue: String(review.rating),
    bestRating: '5',
    worstRating: '1',
  },
}));
const aggregateRating = reviews.length > 0 && averageRating !== null
  ? {
      '@type': 'AggregateRating',
      ratingValue: averageRating.toFixed(1),
      reviewCount: reviews.length,
      bestRating: '5',
      worstRating: '1',
    }
  : null;
const entityMap = entities as Record<string, { sameAs?: string[]; cas?: string | null; molecularFormula?: string | null; pubchem?: string | null; wikidata?: string | null }>;
const productEntity = entityMap[currentSlug];
const additionalProperties = [
  product.data.cas && { '@type': 'PropertyValue', name: 'CAS Number', value: product.data.cas },
  product.data.molecular_weight && { '@type': 'PropertyValue', name: 'Molecular weight', value: product.data.molecular_weight },
  product.data.purity && { '@type': 'PropertyValue', name: 'Purity', value: product.data.purity },
  productEntity?.molecularFormula && { '@type': 'PropertyValue', name: 'Molecular formula', value: productEntity.molecularFormula },
].filter(Boolean);

const relatedProducts = allProductsForLookup
  .filter((candidate) => candidate.id !== product.id && candidate.data.researchArea === product.data.researchArea)
  .slice(0, 4);

const priceValidUntil = new Date(Date.now() + 365 * 24 * 60 * 60 * 1000).toISOString().slice(0, 10);

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  inLanguage: inLanguage(locale),
  name: cleanTitle,
  description: localizedProduct.meta.description,
  image: [productImageUrl],
  sku: product.data.id,
  mpn: product.data.id,
  brand: 'Peptide Shop',
  category: researchAreaName ?? product.data.category,
  ...(productEntity?.sameAs?.length ? { sameAs: productEntity.sameAs } : {}),
  ...(additionalProperties.length ? { additionalProperty: additionalProperties } : {}),
  offers: {
    '@type': 'Offer',
    url: productUrl,
    priceCurrency: 'EUR',
    price: productPrice.toFixed(2),
    priceValidUntil,
    availability: 'https://schema.org/InStock',
    itemCondition: 'https://schema.org/NewCondition',
    seller: {
      '@type': 'Organization',
      name: 'Peptide Shop',
    },
    hasMerchantReturnPolicy: {
      '@type': 'MerchantReturnPolicy',
      applicableCountry: ['DE', 'NL', 'FR', 'IT', 'ES', 'AT', 'BE', 'PL', 'SE', 'DK', 'FI', 'PT'],
      returnPolicyCategory: 'https://schema.org/MerchantReturnFiniteReturnWindow',
      merchantReturnDays: 14,
      returnMethod: 'https://schema.org/ReturnByMail',
      returnFees: 'https://schema.org/FreeReturn',
    },
    shippingDetails: {
      '@type': 'OfferShippingDetails',
      shippingDestination: {
        '@type': 'DefinedRegion',
        addressCountry: ['DE', 'NL', 'FR', 'IT', 'ES', 'AT', 'BE', 'PL', 'SE', 'DK', 'FI', 'PT'],
      },
      shippingRate: {
        '@type': 'MonetaryAmount',
        value: '9.90',
        currency: 'EUR',
      },
      deliveryTime: {
        '@type': 'ShippingDeliveryTime',
        handlingTime: {
          '@type': 'QuantitativeValue',
          minValue: 0,
          maxValue: 1,
          unitCode: 'DAY',
        },
        transitTime: {
          '@type': 'QuantitativeValue',
          minValue: 1,
          maxValue: 5,
          unitCode: 'DAY',
        },
      },
    },
  },
  ...(reviewObjects.length ? { review: reviewObjects } : {}),
  ...(aggregateRating ? { aggregateRating } : {}),
};

const faqSchema = localizedProduct.faqs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
    inLanguage: inLanguage(locale),
      mainEntity: localizedProduct.faqs.map((faq: { question: string; answer: string }) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.answer,
        },
      })),
    }
  : null;

const breadcrumbs = [
  { name: t('common.home'), url: href('/') },
  { name: t('productPage.catalogue'), url: href('/catalog/') },
  ...(researchArea && researchAreaName ? [{ name: researchAreaName, url: href(`/catalog/${researchArea.slug}/`) }] : []),
  { name: cleanTitle, url: href(`/peptides/${currentSlug}/`) },
];
---

<Layout
  title={localizedProduct.meta.title}
  description={localizedProduct.meta.description}
  image={productImage}
  breadcrumbs={breadcrumbs}
  availableLocales={availableLocales}
>
  <JsonLd schema={faqSchema ? [productSchema, faqSchema] : productSchema} />

  <section class="product-page section">
    <div class="container">
      <Breadcrumb items={[
        { name: t('common.home'), url: href('/') },
        { name: t('productPage.catalogue'), url: href('/catalog/') },
        ...(researchArea && researchAreaName ? [{ name: researchAreaName, url: href(`/catalog/${researchArea.slug}/`) }] : []),
        { name: cleanTitle },
      ]} />

      {/*
        Above the fold is two columns: image, then buy. The catalogue sidebar,
        the full-width RUO slab and the long spec list previously split this
        row four ways and squeezed the product shot to roughly 250px — the one
        element a shopper actually looks at first. RUO stays visible as a badge
        here and in the buy box, with the full statement kept further down.
      */}
      <div class="pdp">
        <div class="pdp__media">
          <ProductGallery
            client:load
            images={productImages}
            alt={t('productPage.imageAlt', { product: cleanTitle })}
            labels={{
              zoomHint: t('productPage.zoomHint'),
              close: t('productPage.closeViewer'),
              previous: t('productPage.previousImage'),
              next: t('productPage.nextImage'),
              viewLarger: t('productPage.viewLarger'),
              thumbnailFor: t('productPage.thumbnailFor'),
            }}
          />
        </div>

        <div class="pdp__info">
          <span class="eyebrow">{researchAreaName ?? product.data.category.replace(/-/g, ' ')}</span>
          <h1 class="pdp__title">{cleanTitle}</h1>

          <div class="pdp__badges" aria-label={t('productPage.qualityBadges')}>
            <span class="badge badge-success">{product.data.purity}</span>
            <span class="badge">{t('productPage.coaSupported')}</span>
            <span class="badge badge-warning">RUO</span>
          </div>

          <aside class="buy-box card" aria-label={t('productPage.purchaseOptions')}>
          <ProductOptions
            client:load
            id={product.data.id}
            title={localizedProduct.title}
            basePrice={productPrice}
            packageSizes={product.data.package_sizes}
            moq={product.data.moq}
            image={productImage}
            category={product.data.category}
            labels={{
              price: t('productOptions.price'),
              perVial: t('productOptions.perVial'),
              defaultPackage: t('productOptions.defaultPackage'),
              quantity: t('productOptions.quantity'),
              selectQuantity: t('productOptions.selectQuantity'),
              decreaseQuantity: t('productOptions.decreaseQuantity'),
              increaseQuantity: t('productOptions.increaseQuantity'),
              orderSummary: t('productOptions.orderSummary'),
              subtotal: t('productOptions.subtotal'),
              delivery: t('productOptions.delivery'),
              free: t('productOptions.free'),
              calculatedAtCheckout: t('productOptions.calculatedAtCheckout'),
              addToCart: t('cartActions.addToCart'),
              addedToCart: t('cartActions.addedToCart'),
              minimumNote: t('productOptions.minimumNote'),
              ruoNote: t('productOptions.ruoNote'),
            }}
          />
          <div class="buy-box__links">
            <a href={href('/coa-policy/')} class="btn btn-secondary btn-block">{t('productPage.coaPolicyRequests')}</a>
            <a href={href('/shipping/')} class="btn btn-ghost btn-block">{t('productPage.shippingDetails')}</a>
          </div>
          </aside>

          {/* Four numbers a buyer scans before anything else, value first. */}
          <dl class="fact-grid">
            {product.data.cas && (
              <div class="fact"><dt>CAS</dt><dd>{product.data.cas}</dd></div>
            )}
            {product.data.molecular_weight && (
              <div class="fact"><dt>{t('productPage.molecularWeight')}</dt><dd>{product.data.molecular_weight}</dd></div>
            )}
            <div class="fact"><dt>{t('productPage.packageSizes')}</dt><dd>{product.data.package_sizes.join(', ')}</dd></div>
            <div class="fact"><dt>{t('productPage.storage')}</dt><dd>{localizedProduct.storage.split('(')[0].trim()}</dd></div>
          </dl>

          <div class="hub-links">
            {researchArea && <a class="chip" href={href(`/catalog/${researchArea.slug}/`)}>{researchAreaName ?? researchArea.name}</a>}
            {productUseCases.map((useCase) => useCase && (
              <a class="chip" href={href(`/use-case/${useCase.slug}/`)}>{useCase.name}</a>
            ))}
          </div>
        </div>
      </div>

      {/*
        Detail is collapsed by default. The anchor-link tab strip that used to
        sit here scrolled to sections that were already fully expanded below
        it, so the page opened with several screens of prose nobody had asked
        for. Description stays open as the one section most people want.
      */}
      <div class="pdp-detail">
        <details class="disclose" id="description" open>
          <summary><span>{t('productPage.description')}</span></summary>
          <div class="disclose__body prose-content">
            {locale === 'en' ? <Content /> : (OverrideContent ? <OverrideContent /> : <Fragment set:html={localizedProduct.bodyHtml} />)}
          </div>
        </details>

        <details class="disclose" id="data">
          <summary><span>{t('productPage.sequenceData')}</span></summary>
          <div class="disclose__body">
            <table class="table-clean">
              <tbody>
                <tr><th scope="row">{t('productPage.productId')}</th><td>{product.data.id}</td></tr>
                <tr><th scope="row">CAS</th><td>{product.data.cas ?? t('productPage.notAssigned')}</td></tr>
                <tr><th scope="row">{t('productPage.molecularWeight')}</th><td>{product.data.molecular_weight ?? t('productPage.notAssigned')}</td></tr>
                <tr><th scope="row">{t('productPage.purity')}</th><td>{product.data.purity}</td></tr>
                {product.data.sequence && <tr><th scope="row">{t('productPage.sequence')}</th><td class="text-mono">{product.data.sequence}</td></tr>}
              </tbody>
            </table>
          </div>
        </details>

        <details class="disclose" id="storage">
          <summary><span>{t('productPage.storageHandling')}</span></summary>
          <div class="disclose__body">
            <p>{localizedProduct.storage}</p>
            <p>{t('productPage.storageHandlingBody')}</p>
          </div>
        </details>

        <details class="disclose" id="coa">
          <summary><span>{t('productPage.certificate')}</span></summary>
          <div class="disclose__body">
            <p>{t('productPage.coaBody')}</p>
            <div class="coa-actions">
              <a class="btn btn-primary" href={`/api/coa/${currentSlug}.pdf`} download>
                {t('productPage.downloadCoa')}
              </a>
              <a class="btn btn-secondary" href={`/coa/${currentSlug}.html`} target="_blank" rel="noopener">
                {t('productPage.previewHtml')}
              </a>
              <a class="btn btn-ghost" href={href('/coa-policy/')}>{t('productPage.coaPolicy')}</a>
            </div>
            <details class="coa-langs">
              <summary>{t('productPage.otherLanguages')}</summary>
              <ul>
                {alternateCoaLocales.map((coaLocale) => (
                  <li><a href={`/api/coa/${currentSlug}.pdf?lang=${coaLocale}`} download>{localeMeta[coaLocale].name} (PDF)</a> · <a href={`/coa/${currentSlug}.${coaLocale}.html`} target="_blank" rel="noopener">HTML</a></li>
                ))}
              </ul>
            </details>
          </div>
        </details>

        {localizedProduct.faqs.length > 0 && (
          <details class="disclose" id="faqs">
            <summary><span>{t('productPage.faqs')}</span></summary>
            <div class="disclose__body">
              <ProductFAQs productName={cleanTitle} faqs={localizedProduct.faqs} heading="" />
            </div>
          </details>
        )}
      </div>

      {/* Full research-use statement, kept on the page for compliance. */}
      <RUOBanner
        heading={t('productPage.ruoHeading')}
        detail={t('productPage.ruoDetail')}
      />

      {relatedProducts.length > 0 && (
        <section class="section related-section" aria-labelledby="related-title">
          <span class="eyebrow">{t('productPage.relatedEyebrow')}</span>
          <h2 id="related-title">{t('productPage.relatedTitle', { area: researchAreaName ?? t('productPage.relatedFallbackArea') })}</h2>
          <div class="grid grid-4" style="margin-top: var(--space-8);">
            {relatedProducts.map((related) => (
              <ProductCard product={toCardProduct(related, locale)} />
            ))}
          </div>
        </section>
      )}
    </div>
  </section>
</Layout>

<style>
  .product-page { padding-top: var(--space-8); }

  /* Two columns: the image gets the larger share. */
  .pdp {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(360px, 0.95fr);
    gap: clamp(var(--space-6), 4vw, var(--space-10));
    align-items: start;
    margin-top: var(--space-6);
  }
  .pdp__media { position: sticky; top: 88px; min-width: 0; }
  .pdp__info { min-width: 0; display: flex; flex-direction: column; gap: var(--space-4); }
  .pdp__title {
    margin: 0;
    font-size: clamp(2rem, 1.4rem + 2vw, 2.75rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .pdp__badges,
  .hub-links { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .pdp__info .eyebrow { margin-bottom: calc(var(--space-2) * -1); }

  /* Value-first tiles scan faster than a dt/dd run of labels. */
  .fact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: var(--space-3);
    margin: 0;
  }
  .fact {
    padding: var(--space-3) var(--space-4);
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md, 0.75rem);
  }
  .fact dt {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-ink-3);
    font-weight: 600;
  }
  .fact dd {
    margin: 2px 0 0;
    font-weight: 650;
    color: var(--color-ink);
    font-size: var(--text-sm);
    line-height: 1.35;
  }

  .buy-box { gap: var(--space-4); margin: 0; }
  .buy-box h2 { font-size: var(--text-lg); }
  .buy-box__links { display: grid; gap: var(--space-2); margin-top: var(--space-4); }

  /* Collapsed detail: one row per topic, opened on demand. */
  .pdp-detail {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-12);
  }
  .disclose {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg, 1rem);
    background: var(--color-surface);
    overflow: hidden;
  }
  .disclose > summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    cursor: pointer;
    font-weight: 650;
    font-size: var(--text-lg);
    list-style: none;
    transition: background 0.15s ease;
  }
  .disclose > summary::-webkit-details-marker { display: none; }
  .disclose > summary:hover { background: var(--color-surface-2); }
  .disclose > summary::after {
    content: '';
    flex: none;
    width: 10px; height: 10px;
    border-right: 2px solid var(--color-ink-3);
    border-bottom: 2px solid var(--color-ink-3);
    transform: rotate(45deg) translate(-2px, -2px);
    transition: transform 0.2s ease;
  }
  .disclose[open] > summary::after { transform: rotate(-135deg) translate(-2px, -2px); }
  .disclose[open] > summary { border-bottom: 1px solid var(--color-border); }
  .disclose__body { padding: var(--space-5); }
  .disclose__body > :first-child { margin-top: 0; }
  .product-content { gap: var(--space-4); }
  .prose-content :global(h2),
  .prose-content :global(h3) { margin-top: var(--space-6); }
  .prose-content :global(p),
  .product-detail-layout p { color: var(--color-ink-2); }
  .related-section { padding-bottom: 0; }
  .coa-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }
  .coa-langs { margin-top: var(--space-4); font-size: var(--text-sm); color: var(--color-ink-2); }
  .coa-langs summary { cursor: pointer; color: var(--color-primary); font-weight: 600; }
  .coa-langs ul { margin: var(--space-3) 0 0; padding-left: var(--space-5); display: grid; gap: var(--space-2); }
  .coa-langs a { color: var(--color-primary); text-decoration: none; }
  .coa-langs a:hover { text-decoration: underline; }
  @media (max-width: 960px) {
    .pdp { grid-template-columns: 1fr; }
    .pdp__media { position: static; }
  }
  @media (prefers-reduced-motion: reduce) {
    .disclose > summary,
    .disclose > summary::after { transition: none; }
  }
</style>

<style is:global>
  /* ProductGallery — the image is the largest element on the page. */
  .pgallery { display: grid; gap: var(--space-3); }
  .pgallery__frame {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-lg, 1rem);
    border: 1px solid var(--color-border);
    background: var(--color-surface-2);
    cursor: zoom-in;
    aspect-ratio: 1;
  }
  .pgallery__frame:focus-visible {
    outline: 3px solid var(--color-primary);
    outline-offset: 3px;
  }
  .pgallery__frame img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    transition: transform 0.25s ease-out;
    will-change: transform;
  }
  .pgallery__hint {
    position: absolute;
    left: var(--space-3);
    bottom: var(--space-3);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: 999px;
    background: rgba(15, 23, 42, 0.72);
    color: #fff;
    font-size: 0.8125rem;
    font-weight: 550;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.18s ease, transform 0.18s ease;
    pointer-events: none;
  }
  .pgallery__frame:hover .pgallery__hint,
  .pgallery__frame:focus-visible .pgallery__hint { opacity: 1; transform: translateY(0); }

  .pgallery__thumbs { display: flex; gap: var(--space-2); flex-wrap: wrap; }
  .pgallery__thumb {
    width: 72px; height: 72px;
    padding: 4px;
    border-radius: var(--radius-md, 0.75rem);
    border: 2px solid var(--color-border);
    background: var(--color-surface-2);
    cursor: pointer;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .pgallery__thumb img { width: 100%; height: 100%; object-fit: contain; display: block; }
  .pgallery__thumb:hover { transform: translateY(-2px); }
  .pgallery__thumb.is-active { border-color: var(--color-primary); }

  .pgallery__lightbox {
    position: fixed;
    inset: 0;
