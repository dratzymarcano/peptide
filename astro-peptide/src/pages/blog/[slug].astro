---
import { getCanonicalCollection } from '../../lib/collections';
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import JsonLd from '../../components/JsonLd.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ChipList from '../../components/ChipList.astro';
import { getLocaleFromPathname, localizePath, localeMeta, sourceLocale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import { getLocalizedBlogPost } from '../../i18n/blogContent';
import { getLocalizedProduct } from '../../i18n/productContent';
import { getAvailableLocales, getLocalizedEntry } from '../../lib/localizedEntry';
import { inLanguage } from '../../lib/schema';

export const prerender = false;

const { slug: routeSlug } = Astro.params;
const allPosts = await getCanonicalCollection('blog');
const post = allPosts.find((p) => p.id === routeSlug);
if (!post) {
  return new Response(null, { status: 404 });
}
const locale = (Astro.locals.locale ?? getLocaleFromPathname(Astro.url.pathname));
const t = useTranslations(locale);
const href = (path: string) => localizePath(path, locale);
const dateLocale = localeMeta[locale].og.replace('_', '-');
let localizedPost = getLocalizedBlogPost(post.id, locale, post.data);
const availableLocales = await getAvailableLocales('blog', post.id);

const { Content } = await render(post);

// Per-locale markdown override. When `<locale>/<slug>.md` exists, prefer its
// frontmatter and rendered body over the runtime helper output.
const localeOverride = locale !== sourceLocale
  ? await getLocalizedEntry('blog', post.id, locale)
  : undefined;
const hasOverride = !!(localeOverride && localeOverride.id !== post.id);
const OverrideBody = hasOverride ? (await render(localeOverride!)).Content : null;
if (hasOverride && localeOverride) {
  const od = localeOverride.data;
  localizedPost = {
    ...localizedPost,
    title: od.title,
    description: od.description,
    metaTitle: od.meta.title,
    metaDescription: od.meta.description,
    category: od.category,
    tags: od.tags ?? localizedPost.tags,
    image: od.image ?? localizedPost.image,
  };
}
const relatedPosts = allPosts
  .filter((candidate) => candidate.data.category === post.data.category && candidate.id !== post.id)
  .sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime())
  .slice(0, 3)
  .map((entry) => ({ entry, content: getLocalizedBlogPost(entry.id, locale, entry.data) }));

const allProducts = await getCanonicalCollection('products');
const matchedProduct = allProducts.find((p) => {
  const pId = p.id.toLowerCase();
  const slug = post.id.toLowerCase();
  if (slug.includes(pId)) return true;
  if (slug.includes('epithalon') && pId === 'epitalon') return true;
  if (slug.includes('tb-500') && pId === 'tb-500') return true;
  if (slug.includes('cjc-1295') && pId.includes('cjc-1295')) return true;
  if (slug.includes('nad') && pId === 'nad-plus') return true;
  return false;
});
const localizedMatchedProduct = matchedProduct ? getLocalizedProduct(matchedProduct, locale) : null;

const siteUrl = 'https://peptide-kaufen.net';
const postUrl = new URL(href(`/blog/${post.id}/`), Astro.site).toString();
// Article images must be raster and crawlable; the fallback was the SVG
// favicon, which Google rejects outright for the article-image feature.
const rawImage = post.data.image && !post.data.image.endsWith('.svg') ? post.data.image : '/brand/og-default.jpg';
const imageUrl = new URL(rawImage, siteUrl).href;
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: localizedPost.title,
  description: localizedPost.metaDescription,
  image: [imageUrl],
  inLanguage: inLanguage(locale),
  datePublished: new Date(post.data.publishDate).toISOString(),
  dateModified: new Date(post.data.updatedDate ?? post.data.publishDate).toISOString(),
  mainEntityOfPage: { '@type': 'WebPage', '@id': postUrl },
  // Authored by the editorial desk rather than a named individual, so the
  // author is an Organization. Emitting `Person` for a collective byline
  // invents credentials that cannot be verified (and pointed `@id`/`sameAs`
  // at an /about/ anchor that does not exist). Swap this back to a `Person`
  // with a real bio page the moment articles carry a named, credentialed
  // author — that is the strongest available E-E-A-T signal for YMYL content.
  author: {
    '@type': 'Organization',
    '@id': `${siteUrl}/#organization`,
    name: localizedPost.author,
    url: `${siteUrl}/about/`,
  },
  reviewedBy: {
    '@type': 'Organization',
    name: 'Wissenschaftliche Fachredaktion Peptide Shop',
    url: `${siteUrl}/about/`,
    description: 'Fachliche Prüfung auf biochemische Exaktheit, Quellenvalidität und Labor-Forschungsstandards (RUO).',
  },
  publishingPrinciples: `${siteUrl}/quality/`,
  isAccessibleForFree: true,
  publisher: {
    '@type': 'Organization',
    '@id': `${siteUrl}/#organization`,
    name: 'Peptide Shop',
    url: siteUrl,
    logo: { '@type': 'ImageObject', url: `${siteUrl}/brand/peptide-shop-logo.png`, width: 600, height: 148 },
  },
};

// HowTo schema: emit on the storage/handling article only.
const howToSchema = post.id === 'peptide-storage-handling-best-practices'
  ? {
      '@context': 'https://schema.org',
      '@type': 'HowTo',
      name: 'How to store and reconstitute lyophilised research peptides',
      description: 'Step-by-step storage and reconstitution workflow for lyophilised research peptides to maintain stability and analytical purity.',
      inLanguage: inLanguage(locale),
      totalTime: 'PT15M',
      tool: [
        { '@type': 'HowToTool', name: 'Bacteriostatic water (0.9% benzyl alcohol)' },
        { '@type': 'HowToTool', name: 'Sterile insulin syringe' },
        { '@type': 'HowToTool', name: 'Lyophilised peptide vial' },
      ],
      step: [
        { '@type': 'HowToStep', position: 1, name: 'Equilibrate the vial', text: 'Remove the lyophilised peptide vial from −20 °C storage and let it equilibrate at room temperature for 20–30 minutes to prevent moisture condensation on the powder.' },
        { '@type': 'HowToStep', position: 2, name: 'Calculate diluent volume', text: 'Calculate the volume of bacteriostatic water required for your target concentration based on the labelled mass per vial.' },
        { '@type': 'HowToStep', position: 3, name: 'Reconstitute slowly', text: 'Direct the diluent stream against the inner glass wall (never directly onto the lyophilisate cake) to avoid foaming and shear stress.' },
        { '@type': 'HowToStep', position: 4, name: 'Dissolve gently', text: 'Swirl the vial gently until fully dissolved. Do not shake. The solution should be clear and free of particulates.' },
        { '@type': 'HowToStep', position: 5, name: 'Refrigerate', text: 'Store reconstituted peptide at 2–8 °C and use within the validated stability window stated on the certificate of analysis.' },
      ],
    }
  : null;
const rawContent = post.body ?? '';
const wordCount = rawContent.split(/\s+/).filter(Boolean).length;
const readingTimeMin = Math.max(3, Math.ceil(wordCount / 180));

const breadcrumbs = [
  { name: t('common.home'), url: href('/') },
  { name: t('blog.breadcrumb'), url: href('/blog/') },
  { name: localizedPost.title, url: href(`/blog/${post.id}/`) },
];
---

<Layout
  title={localizedPost.metaTitle}
  description={localizedPost.metaDescription}
  image={localizedPost.image}
  article={true}
  breadcrumbs={breadcrumbs}
  availableLocales={availableLocales}
>
  <JsonLd schema={howToSchema ? [articleSchema, howToSchema] : articleSchema} />

  <article class="content-page article-page section">
    <div class="container">
      <Breadcrumb items={breadcrumbs} />

      <header class="article-header">
        <div class="article-header__meta-top">
          <span class="badge badge-blue">{localizedPost.category}</span>
          <span class="article-read-time">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span>{readingTimeMin} Min. Lesezeit</span>
          </span>
          <span class="article-peer-review">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
            <span>Wissenschaftlich geprüft (RUO)</span>
          </span>
        </div>

        <h1 class="article-title">{localizedPost.title}</h1>
        <p class="article-lead">{localizedPost.description}</p>

        <div class="article-author-row">
          <div class="article-author-info">
            <div class="author-avatar" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            </div>
            <div>
              <span class="author-name">{localizedPost.author}</span>
              <span class="author-desc">Wissenschaftliche Redaktion · Peptide Shop</span>
            </div>
          </div>
          <div class="article-date">
            <time datetime={post.data.publishDate}>
              {new Date(localizedPost.publishDate).toLocaleDateString(dateLocale, { day: 'numeric', month: 'long', year: 'numeric' })}
            </time>
          </div>
        </div>
      </header>

      {localizedPost.image && (
        <figure class="article-hero-image">
          <img src={localizedPost.image} alt={localizedPost.title} loading="eager" width="1200" height="630" decoding="async" />
        </figure>
      )}

      <div class="content-layout">
        <main class="article-body card">
          <div class="prose-content">
            {locale === sourceLocale ? <Content /> : (OverrideBody ? <OverrideBody /> : (localizedPost.bodyHtml ? <Fragment set:html={localizedPost.bodyHtml} /> : <Content />))}
          </div>

          {matchedProduct && localizedMatchedProduct && (
            <div class="article-product-callout">
              <div class="callout-inner">
                <div class="callout-text">
                  <span class="callout-badge">Laborreagenz zur Studie</span>
                  <h3 class="callout-title">
                    {localizedMatchedProduct.cleanTitle} ({matchedProduct.data.purity})
                  </h3>
                  <p class="callout-desc">
                    Synthetisiert nach cGMP-Standards mit chargenbezogenem HPLC/MS-Reinheitszertifikat für reproduzierbare In-vitro-Forschung.
                  </p>
                </div>
                <div class="callout-actions">
                  <a href={href(`/peptides/${matchedProduct.id}/`)} class="btn btn-primary btn-sm">
                    {localizedMatchedProduct.cleanTitle} HPLC-Zertifikat & Bestellen →
                  </a>
                  <a href={href('/peptid-rechner/')} class="btn btn-secondary btn-sm">
                    Peptid-Rechner öffnen
                  </a>
                </div>
              </div>
            </div>
          )}

          {localizedPost.tags.length > 0 && (
            <footer class="article-tags">
              <span class="tags-label">Themen & Schlagwörter:</span>
              <ChipList items={localizedPost.tags} />
            </footer>
          )}
        </main>

        <aside class="content-sidebar">
          {matchedProduct && localizedMatchedProduct && (
            <section class="card product-sidebar-card">
              <span class="sidebar-badge">Referenz-Standard</span>
              <h3 class="sidebar-product-title">
                <a href={href(`/peptides/${matchedProduct.id}/`)}>
                  {localizedMatchedProduct.cleanTitle}
                </a>
              </h3>
              <div class="sidebar-pills">
                <span class="badge badge-success">{matchedProduct.data.purity}</span>
                <span class="badge">COA geprüft</span>
                <span class="badge badge-warning">RUO</span>
              </div>
              <p class="sidebar-desc">
                Lyophilisierte Reinstsubstanz für In-vitro- und Laboranalysen.
              </p>
              <div class="sidebar-actions">
                <a class="btn btn-primary btn-block" href={href(`/peptides/${matchedProduct.id}/`)}>
                  {localizedMatchedProduct.cleanTitle} Reagenz ansehen →
                </a>
                <a class="btn btn-ghost btn-sm btn-block" href={href('/peptid-rechner/')}>
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="display:inline; vertical-align:-1px; margin-right:4px;"><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="8" y1="6" x2="16" y2="6"/></svg>
                  Peptid-Dosierungsrechner (IE / ml)
                </a>
              </div>
            </section>
          )}

          {relatedPosts.length > 0 && (
            <section class="card related-posts-card">
              <h2>{t('blogArticle.relatedArticles')}</h2>
              <div class="related-list">
                {relatedPosts.map((related) => (
                  <a href={href(`/blog/${related.entry.id}/`)} class="related-item">
                    <strong class="related-title">{related.content.title}</strong>
                    <span class="related-date">{new Date(related.content.publishDate).toLocaleDateString(dateLocale, { day: 'numeric', month: 'short' })}</span>
                  </a>
                ))}
              </div>
            </section>
          )}

          <section class="card calculator-promo-card">
            <h3>Peptid-Dosierungsrechner</h3>
            <p>Berechnen Sie das exakte Mischverhältnis von lyophilisiertem Peptidpulver und bakteriostatischem Wasser in Insulineinheiten (IE).</p>
            <a class="btn btn-secondary btn-block" href={href('/peptid-rechner/')}>Zum Peptid-Rechner →</a>
          </section>

          <a class="btn btn-ghost btn-block" href={href('/blog/')}>← {t('blogArticle.backToNotes')}</a>
        </aside>
      </div>
    </div>
  </article>
</Layout>

<style>
  .article-page {
    padding-top: var(--space-8);
    padding-bottom: var(--space-16);
  }

  .article-header {
    margin-top: var(--space-6);
    margin-bottom: var(--space-8);
    max-width: 900px;
  }
  .article-header__meta-top {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-bottom: var(--space-3);
  }
  .article-read-time {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8125rem;
    color: var(--color-ink-3);
    font-weight: 550;
  }
  .article-peer-review {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.75rem;
    font-weight: 600;
    color: #047857;
    background: #ECFDF5;
    border: 1px solid #A7F3D0;
    padding: 2px 8px;
    border-radius: 999px;
  }

  .article-title {
    font-size: clamp(2rem, 1.4rem + 2vw, 2.85rem);
    line-height: 1.15;
    letter-spacing: -0.03em;
    font-weight: 800;
    color: var(--color-ink);
    margin: 0 0 var(--space-4);
    font-family: var(--font-display);
  }
  .article-lead {
    font-size: clamp(1.05rem, 1rem + 0.3vw, 1.25rem);
    line-height: 1.6;
    color: var(--color-ink-2);
    margin: 0 0 var(--space-6);
  }

  .article-author-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }
  .article-author-info {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .author-avatar {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: #EFF8FC;
    color: var(--color-primary);
    border: 1px solid #BAE3F7;
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }
  .author-name {
    display: block;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-ink);
  }
  .author-desc {
    display: block;
    font-size: 0.75rem;
    color: var(--color-ink-3);
  }
  .article-date {
    font-size: 0.8125rem;
    color: var(--color-ink-3);
    font-weight: 500;
  }

  .article-hero-image {
    margin: 0 0 var(--space-8);
    border-radius: var(--radius-lg, 16px);
    overflow: hidden;
    border: 1px solid var(--color-border);
    box-shadow: 0 4px 20px -2px rgba(15, 23, 42, 0.06);
  }
  .article-hero-image img {
    width: 100%;
    max-height: 480px;
    object-fit: cover;
    display: block;
  }

  .content-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    gap: var(--space-8);
    align-items: start;
  }

  .article-body {
    background: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg, 16px);
    padding: clamp(var(--space-6), 4vw, var(--space-10));
    box-shadow: 0 2px 10px -2px rgba(15, 23, 42, 0.04);
  }

  .prose-content {
    font-size: 1.0625rem;
    line-height: 1.8;
    color: var(--color-ink-2);
  }
  .prose-content :global(h2) {
    font-size: 1.65rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border);
  }
  .prose-content :global(h3) {
    font-size: 1.25rem;
    font-weight: 750;
    color: var(--color-ink);
    margin-top: 1.8rem;
    margin-bottom: 0.75rem;
  }
  .prose-content :global(p) {
    margin-bottom: 1.4rem;
  }
  .prose-content :global(ul),
  .prose-content :global(ol) {
    margin: 1.2rem 0 1.5rem;
    padding-left: 1.5rem;
  }
  .prose-content :global(li) {
    margin-bottom: 0.5rem;
  }
  .prose-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.8rem 0;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    overflow: hidden;
  }
  .prose-content :global(th) {
    background: var(--color-surface-2);
    padding: 10px 14px;
    font-size: 0.8125rem;
    font-weight: 700;
    text-align: left;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-ink);
  }
  .prose-content :global(td) {
    padding: 10px 14px;
    border-bottom: 1px solid var(--color-border);
    font-size: 0.875rem;
    color: var(--color-ink-2);
  }
  .prose-content :global(blockquote) {
    background: #EFF8FC;
    border-left: 4px solid var(--color-primary);
    padding: 14px 18px;
    border-radius: 0 10px 10px 0;
    margin: 1.6rem 0;
    font-style: italic;
    color: var(--color-ink);
  }

  .article-product-callout {
    margin-top: var(--space-10);
    padding: var(--space-5);
    background: linear-gradient(135deg, #F8FAFC 0%, #EFF8FC 100%);
    border: 1.5px solid #BAE3F7;
    border-radius: 14px;
    box-shadow: 0 4px 14px -2px rgba(0, 119, 182, 0.08);
  }
  .callout-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-4);
  }
  .callout-badge {
    display: inline-block;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: 4px;
  }
  .callout-title {
    margin: 0 0 6px;
    font-size: 1.2rem;
    color: var(--color-ink);
    font-weight: 750;
  }
  .callout-desc {
    margin: 0;
    font-size: 0.875rem;
    color: var(--color-ink-2);
    max-width: 520px;
  }
  .callout-actions {
    display: flex;
    gap: var(--space-2);
    align-items: center;
    flex-wrap: wrap;
  }

  .article-tags {
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }
  .tags-label {
    display: block;
    font-size: 0.8125rem;
    font-weight: 650;
    color: var(--color-ink-3);
    margin-bottom: 8px;
  }

  /* Content Sidebar */
  .content-sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    position: sticky;
    top: 96px;
  }
  .product-sidebar-card {
    background: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md, 12px);
    padding: var(--space-4);
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
  }
  .sidebar-badge {
    display: inline-block;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: 4px;
  }
  .sidebar-product-title {
    margin: 0 0 8px;
    font-size: 1.15rem;
    font-weight: 750;
  }
  .sidebar-product-title a {
    color: var(--color-ink);
    text-decoration: none;
  }
  .sidebar-product-title a:hover {
    color: var(--color-primary);
  }
  .sidebar-pills {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin-bottom: 10px;
  }
  .sidebar-desc {
    font-size: 0.8125rem;
    color: var(--color-ink-3);
    margin-bottom: 12px;
    line-height: 1.45;
  }
  .sidebar-actions {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .related-posts-card {
    background: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md, 12px);
    padding: var(--space-4);
  }
  .related-posts-card h2 {
    font-size: 1rem;
    font-weight: 750;
    margin: 0 0 10px;
    color: var(--color-ink);
  }
  .related-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .related-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
    text-decoration: none;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--color-border-subtle);
    transition: all 0.15s ease;
  }
  .related-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }
  .related-title {
    font-size: 0.875rem;
    color: var(--color-ink);
    line-height: 1.35;
    font-weight: 650;
  }
  .related-item:hover .related-title {
    color: var(--color-primary);
  }
  .related-date {
    font-size: 0.75rem;
    color: var(--color-ink-3);
  }

  .calculator-promo-card {
    background: #F8FAFC;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md, 12px);
    padding: var(--space-4);
  }
  .calculator-promo-card h3 {
    margin: 0 0 6px;
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-ink);
  }
