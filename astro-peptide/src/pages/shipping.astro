---
import Layout from '../layouts/Layout.astro';
import PageHeading from '../components/PageHeading.astro';
import { getLocaleFromPathname, localizePath } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

const locale = (Astro.locals.locale ?? getLocaleFromPathname(Astro.url.pathname));
const t = useTranslations(locale);
const href = (path: string) => localizePath(path, locale);

const breadcrumbs = [
  { name: t('common.home'), url: href('/') },
  { name: t('support.shipping'), url: href('/shipping/') },
];
---

<Layout
  title={t('support.shippingMetaTitle')}
  description={t('support.shippingMetaDescription')}
  breadcrumbs={breadcrumbs}
>
  <section class="section content-page">
    <div class="container">
      <PageHeading
        eyebrow={t('support.shipping')}
        title={t('support.shippingTitle')}
        description={t('support.shippingDescription')}
      />

      {/* DACH REGIONAL HUBS GRID */}
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.25rem; margin-bottom: var(--space-8);">
        <div class="card" style="border: 1px solid var(--color-border); background: #ffffff; padding: 1.5rem;">
          <span style="font-size: 1.75rem; display: block; margin-bottom: 0.5rem;">🇩🇪</span>
          <h3 style="margin: 0 0 0.5rem; font-size: 1.15rem;">Deutschland</h3>
          <p style="font-size: 0.88rem; color: var(--color-ink-2); margin-bottom: 1rem; line-height: 1.5;">
            <strong>1 bis 2 Werktage</strong> Regellaufzeit per DHL Paket. Direkte Zustellung an deutsche Packstationen und Filialen möglich.
          </p>
          <span class="badge badge-neutral">DHL Express optional</span>
        </div>

        <div class="card" style="border: 1px solid var(--color-border); background: #ffffff; padding: 1.5rem;">
          <span style="font-size: 1.75rem; display: block; margin-bottom: 0.5rem;">🇦🇹</span>
          <h3 style="margin: 0 0 0.5rem; font-size: 1.15rem;">Österreich (Inland)</h3>
          <p style="font-size: 0.88rem; color: var(--color-ink-2); margin-bottom: 1rem; line-height: 1.5;">
            <strong>24 Stunden Express</strong> direkt aus unserem Hauptstandort in Wien. Inländische Zustellung per Österreichische Post und DPD ohne Grenzübergang.
          </p>
          <a href={href('/versand-oesterreich/')} class="btn btn-secondary btn-sm" style="width: 100%; text-align: center;">Details für Österreich →</a>
        </div>

        <div class="card" style="border: 1px solid var(--color-border); background: #ffffff; padding: 1.5rem;">
          <span style="font-size: 1.75rem; display: block; margin-bottom: 0.5rem;">🇨🇭</span>
          <h3 style="margin: 0 0 0.5rem; font-size: 1.15rem;">Schweiz</h3>
          <p style="font-size: 0.88rem; color: var(--color-ink-2); margin-bottom: 1rem; line-height: 1.5;">
            <strong>2 bis 3 Werktage</strong> via Schweizerische Post Priority. Vollständig zollabgefertigt mit lückenloser Sendungsverfolgung.
          </p>
          <a href={href('/versand-schweiz/')} class="btn btn-secondary btn-sm" style="width: 100%; text-align: center;">Details für die Schweiz →</a>
        </div>
      </div>

      <div class="content-layout">
        <article class="article-body">
<h2>{t('support.dispatchTitle')}</h2>
          <figure class="editorial-figure">
            <img
              src="/images/lifestyle/peptide-shipping-box.jpg"
              alt="Peptide vials packaged in a shipping box with cold-chain protection"
              loading="lazy"
              width="800"
              height="1067"
            />
          </figure>
          <p>{t('support.dispatchBody')}</p>

          <h2>{t('support.temperatureTitle')}</h2>
          <p>{t('support.temperatureBody')}</p>

          <h2>{t('support.receivingTitle')}</h2>
          <ul>
            <li>{t('support.receivingInspect')}</li>
            <li>{t('support.receivingMatch')}</li>
            <li>{t('support.receivingStore')}</li>
            <li>{t('support.receivingRecord')}</li>
          </ul>

          <h2>{t('support.internationalTitle')}</h2>
          <p>{t('support.internationalBody')}</p>
        </article>

        <aside class="content-sidebar" aria-label={t('support.relatedInfo')}>
<div class="card">
            <h2>{t('support.needDocuments')}</h2>
            <p>{t('support.needDocumentsBody')}</p>
            <a class="btn btn-primary" href={href('/contact/')}>{t('support.contactSupport')}</a>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Layout>

<style>
  .editorial-figure {
    margin: 0 0 var(--space-6, 1.5rem);
    border-radius: var(--radius-xl, 1rem);
    overflow: hidden;
    border: 1px solid var(--color-border, rgba(0, 0, 0, 0.08));
    box-shadow: var(--shadow-soft-3, 0 8px 32px rgba(0, 0, 0, 0.06));
    aspect-ratio: 4 / 3;
  }
  .editorial-figure img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
