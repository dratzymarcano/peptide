---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEO from '../components/SEO.astro';
import JsonLd from '../components/JsonLd.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import AgeGate from '../components/AgeGate';
import { getLocaleFromPathname, localeMeta, locales, type Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import { breadcrumbSchema as buildBreadcrumbSchema } from '../lib/schema';
// Font faces live in public/css/design-system.css against stable /fonts/
// URLs so they can be preloaded in <head>. Importing the @fontsource CSS
// here would re-emit the same faces under content-hashed paths that cannot
// be preloaded.

interface BreadcrumbItem {
	name: string;
	url: string;
}

interface Props {
	title: string;
	description?: string;
	image?: string;
	article?: boolean;
	breadcrumbs?: BreadcrumbItem[];
	noindex?: boolean;
	availableLocales?: Locale[];
	/**
	 * LCP image to preload. A CSS `background-image` is invisible to the
	 * browser's preload scanner, so it only starts downloading after the
	 * stylesheet is parsed — which made the homepage hero a 3.3s LCP. Pages
	 * whose largest element is a background image should declare it here.
	 */
	preloadImage?: string;
	/** Overrides the self-referencing canonical. See SEO.astro. */
	canonical?: string;
}

const { title, description, image, article, breadcrumbs, noindex = false, availableLocales = [...locales], preloadImage, canonical } = Astro.props;
const locale = (Astro.locals.locale ?? getLocaleFromPathname(Astro.url.pathname));
const t = useTranslations(locale);

const breadcrumbSchema = breadcrumbs && breadcrumbs.length > 0 ? buildBreadcrumbSchema(breadcrumbs, locale) : null;
---

<!doctype html>
<html lang={locale} dir={localeMeta[locale].dir}>
	<head>
		{/*
			geo.* meta tags target a single country. They must only be emitted on the
			German locale — emitting them on the global English / NL / FR / IT / ES
			versions sends a conflicting geo signal that fights the per-locale
			hreflang + GSC International Targeting strategy.
		*/}
		{locale === 'de' && (
			<>
				<meta name="geo.region" content="DE" />
				<meta name="geo.placename" content="Germany" />
			</>
		)}
		<SEO title={title} description={description} image={image} article={article} noindex={noindex} availableLocales={availableLocales} canonical={canonical} />

		{breadcrumbSchema && (
			<JsonLd schema={breadcrumbSchema} />
		)}

		<!-- European DACH Typography: Plus Jakarta Sans (Display & Headings) + Inter (Body) + JetBrains Mono (Scientific Specs) -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />

		<!-- Inter and JetBrains Mono self-hosted fallbacks -->
		<style is:inline>
			:root {
				--font-display: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
				--font-sans: 'Inter Variable', 'Inter', system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
				--font-mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
			}
			body {
				font-family: var(--font-sans);
			}
			h1, h2, h3, h4, .font-display {
				font-family: var(--font-display);
				letter-spacing: -0.025em;
			}
		</style>

		<link rel="preload" as="font" type="font/woff2" href="/fonts/inter-latin-wght-normal.woff2" crossorigin />
		<link rel="preload" as="font" type="font/woff2" href="/fonts/inter-tight-latin-wght-normal.woff2" crossorigin />
		{preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}

		<!-- Design-system tokens (DESIGN_SPEC § 13). Loaded globally. -->
		<link rel="stylesheet" href="/css/design-system.css" />
		<style is:inline>
			body { background-color: #ffffff; color: var(--color-ink, #0F172A); -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; }

			/*
			 * Must stay in <head>. This lived in a <style> at the end of <body>,
			 * so during parse the skip link was a normal in-flow element ~25px
			 * tall that pushed the whole document down; when the parser reached
			 * the style it went out of flow and everything jumped up again.
			 * That single rule was 0.017 CLS on nearly every page.
			 */
			.skip-to-content {
				position: absolute; left: -9999px; top: 0; z-index: 10000;
				padding: 12px 24px; background: var(--color-primary, #0077B6); color: #fff;
				font-weight: 600; text-decoration: none; border-radius: 0 0 8px 8px;
			}
			.skip-to-content:focus { left: 50%; transform: translateX(-50%); }
		</style>
	</head>
	<body>
		<a href="#main-content" class="skip-to-content">Skip to main content</a>
		<Header />
		<main id="main-content" class="main-wrapper">
			<slot />
		</main>
		<Footer />
		<LanguageSwitcher />
		<AgeGate
			labels={{
				title: t('ageGate.title'),
				body: t('ageGate.body'),
				legalNote: t('ageGate.legalNote'),
				confirm: t('ageGate.confirm'),
				deny: t('ageGate.deny'),
			}}
			client:load
		/>

		<!-- Zoho SalesIQ Livechat -->
		<script is:inline>
			window.$zoho = window.$zoho || {};
			window.$zoho.salesiq = window.$zoho.salesiq || { ready: function () {} };
			window.openLiveChat = function () {
				try {
					if (window.$zoho?.salesiq?.chat?.start) {
						window.$zoho.salesiq.chat.start();
						return;
					}
					if (window.$zoho?.salesiq?.floatwindow?.visible) {
						window.$zoho.salesiq.floatwindow.visible('show');
						return;
					}
					var widget = document.getElementById('zsiq_float') ||
						document.getElementById('zsiq_agtpic') ||
						document.getElementById('zsiq_mwt') ||
						document.querySelector('.zsiq_float_chat') ||
						document.querySelector('[id*="zsiq"]');
					if (widget) {
						widget.click();
						return;
					}
					var prevReady = window.$zoho.salesiq.ready;
					window.$zoho.salesiq.ready = function () {
						if (typeof prevReady === 'function') prevReady();
						if (window.$zoho?.salesiq?.chat?.start) {
							window.$zoho.salesiq.chat.start();
						} else if (window.$zoho?.salesiq?.floatwindow?.visible) {
							window.$zoho.salesiq.floatwindow.visible('show');
						}
					};
				} catch (e) {
					console.error('Error opening live chat:', e);
				}
			};
		</script>
		<script is:inline id="zsiqscript" src="https://salesiq.zohopublic.com/widget?wc=siqe42b798a524681e48e42aa4ffb2d35d1904e93cf43670b9cb4fe2648e83fe1b8" defer></script>
	</body>
</html>
