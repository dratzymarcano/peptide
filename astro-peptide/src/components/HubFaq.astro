---
/**
 * Three questions every hub page can answer truthfully from catalogue data.
 *
 * Rendered on the page, not only in JSON-LD — an FAQ rich result requires the
 * same text to be visible to the reader, and the answers are the three
 * objections that stop a first order: purity, documentation, and what the
 * material may lawfully be used for.
 */
import JsonLd from './JsonLd.astro';
import { getLocaleFromPathname, type Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import { faqSchema } from '../lib/schema';

interface Props {
  /** Translated group name, e.g. "Diabetes & Metabolism". */
  group: string;
  /** Numeric HPLC purity floor across the group, e.g. 98. */
  purityFloor: number;
}

const { group, purityFloor } = Astro.props;
const locale = (Astro.locals.locale ?? getLocaleFromPathname(Astro.url.pathname)) as Locale;
const t = useTranslations(locale);

const faqs = [1, 2, 3].map((n) => ({
  q: t(`hub.faq${n}Q`, { group, purity: purityFloor }),
  a: t(`hub.faq${n}A`, { group, purity: purityFloor }),
}));
---

<section class="hub-faq" aria-labelledby="hub-faq-title">
  <JsonLd schema={faqSchema(faqs, locale)} />
  <h2 id="hub-faq-title">{t('hub.faqTitle')}</h2>
  <div class="hub-faq__list">
    {faqs.map((faq, index) => (
      <details class="hub-faq__item" open={index === 0}>
        <summary>{faq.q}</summary>
        <p>{faq.a}</p>
      </details>
    ))}
  </div>
</section>

<style>
  .hub-faq { margin-top: var(--space-16); }
  .hub-faq h2 {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 1.1rem + 1vw, 1.9rem);
    letter-spacing: -0.02em;
    margin: 0 0 var(--space-6);
  }
  .hub-faq__list { display: grid; gap: var(--space-3); max-width: 62rem; }
  .hub-faq__item {
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-4) var(--space-5);
  }
  .hub-faq__item summary {
    cursor: pointer;
    font-weight: 600;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 32px;
  }
  .hub-faq__item summary::-webkit-details-marker { display: none; }
  .hub-faq__item summary::after {
    content: '';
    flex: none;
    width: 10px; height: 10px;
    border-right: 2px solid var(--color-ink-3);
    border-bottom: 2px solid var(--color-ink-3);
    transform: rotate(45deg) translateY(-2px);
    transition: transform 160ms ease;
  }
  .hub-faq__item[open] summary::after { transform: rotate(-135deg) translateY(-2px); }
  .hub-faq__item p { margin: var(--space-3) 0 0; color: var(--color-ink-3); max-width: 70ch; }
</style>
