---
interface Props {
	title: string;
	description?: string;
	image?: string;
	imageAlt?: string;
	article?: boolean;
	noindex?: boolean;
	availableLocales?: typeof locales[number][];
	/**
	 * Absolute or site-root-relative canonical URL, overriding the default
	 * self-referencing one. Used where the same content is served under several
	 * locale prefixes without being translated — the /learn/ reference articles
	 * render their English body at /de/learn/…, /fr/learn/… and so on, so those
	 * URLs must consolidate onto the English original rather than compete with
	 * it as duplicates.
	 */
	canonical?: string;
}

import { getLocaleFromPathname, localizePath, localeMeta, locales, defaultLocale } from '../i18n/config';
import { clampMetaDescription } from '../lib/seo';

const { title, description: rawDescription, image, imageAlt, article, noindex = false, availableLocales = locales, canonical } = Astro.props;
const description = clampMetaDescription(rawDescription);
const locale = (Astro.locals.locale ?? getLocaleFromPathname(Astro.url.pathname));
const rawCanonicalPath = canonical ?? localizePath(Astro.url.pathname, locale);
const canonicalURL = new URL(rawCanonicalPath, Astro.site);
if (!canonicalURL.pathname.endsWith('/') && !canonicalURL.pathname.includes('.')) {
	canonicalURL.pathname = `${canonicalURL.pathname}/`;
}
const siteName = 'Peptide Shop';
const ogLocale = localeMeta[locale].og;
// No social platform renders an SVG share card — Facebook, LinkedIn, X,
// WhatsApp and Slack all skip it and fall back to a blank rectangle. The
// default used to be the SVG wordmark, and 29 of the 51 catalogue products
// still illustrate with placeholder SVG line art, so most pages on the site
// shared as nothing at all. Anything vector falls back to the 1200×630 JPEG
// card generated by `npm run brand:rasters`.
const defaultOgImage = '/brand/og-default.jpg';
const requestedOgImage = image ?? defaultOgImage;
const ogImage = requestedOgImage.endsWith('.svg') ? defaultOgImage : requestedOgImage;
const isDefaultOgImage = ogImage === defaultOgImage;
// Resolve against the canonical origin, not the request URL: a preview or
// staging host would otherwise stamp its own hostname into the shared card.
const ogImageUrl = new URL(ogImage, Astro.site);
const ogImageAlt = isDefaultOgImage
	? `${siteName} | Forschungspeptide mit chargenbezogenem Analysezertifikat (COA)`
	: (imageAlt ?? title);
const publishedLocales = locales.filter((alternateLocale) => availableLocales.includes(alternateLocale));
// A single-language page needs no alternate cluster: an hreflang set of one
// self-reference plus x-default is noise, and it previously advertised five
// languages that did not exist for the untranslated /learn/ articles.
const alternateUrls = publishedLocales.length > 1
	? publishedLocales.map((alternateLocale) => {
		const altUrl = new URL(localizePath(Astro.url.pathname, alternateLocale), Astro.site);
		if (!altUrl.pathname.endsWith('/') && !altUrl.pathname.includes('.')) {
			altUrl.pathname = `${altUrl.pathname}/`;
		}
		return {
			locale: alternateLocale,
			hreflang: localeMeta[alternateLocale].hreflang,
			href: altUrl,
		};
	})
	: [];
// x-default names the version served to a visitor no hreflang tag matches —
// which is whatever sits at the unprefixed root, now German.
const xDefaultLocale = publishedLocales.includes(defaultLocale) ? defaultLocale : publishedLocales[0];
const xDefaultUrl = new URL(localizePath(Astro.url.pathname, xDefaultLocale), Astro.site);
if (!xDefaultUrl.pathname.endsWith('/') && !xDefaultUrl.pathname.includes('.')) {
	xDefaultUrl.pathname = `${xDefaultUrl.pathname}/`;
}
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="color-scheme" content="light" />
<meta name="format-detection" content="telephone=no" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="icon" href="/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#0077B6" />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />
{alternateUrls.map((alternate) => (
	<link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />
))}
{alternateUrls.length > 0 && xDefaultLocale && (
	<link rel="alternate" hreflang="x-default" href={xDefaultUrl} />
)}

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
{description && <meta name="description" content={description} />}

<!-- Open Graph / Facebook -->
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content={ogLocale} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:alt" content={ogImageAlt} />
{/* Declared dimensions let crawlers lay the card out before the bytes land,
    which is what stops the first share of a URL rendering untitled. */}
{isDefaultOgImage && (
	<>
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
	</>
)}

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
{/* `twitter:site` is deliberately absent. It pointed at @peptideshop, an
    account the business does not own — attributing the site to a stranger's
    profile on every card. Restore it here once a real handle exists. */}
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={title} />
{description && <meta property="twitter:description" content={description} />}
<meta property="twitter:image" content={ogImageUrl} />
<meta property="twitter:image:alt" content={ogImageAlt} />

<!-- Robots -->
{noindex
	? <meta name="robots" content="noindex, follow" />
	: <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}
