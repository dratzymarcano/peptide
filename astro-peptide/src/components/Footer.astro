---
// Footer — DESIGN_SPEC §5.4
// 6 columns, RUO disclaimer pinned, no Bootstrap, no jQuery.
import { researchAreas, useCases } from '../data/taxonomy';
import { getLocaleFromPathname, localizePath } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

const featured = researchAreas.slice(0, 6);
const year = new Date().getFullYear();
const locale = (Astro.locals.locale ?? getLocaleFromPathname(Astro.url.pathname));
const t = useTranslations(locale);
const href = (path: string) => localizePath(path, locale);
---

<footer class="site-footer" role="contentinfo">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-col footer-col--brand">
        <a href={href('/')} class="footer-brand" aria-label={t('nav.homeLabel')}>
          <div class="footer-brand__mark-wrap">
            <img
              src="/brand/logo-mark.png"
              width="28"
              height="28"
              alt="Peptide Shop Logo"
              class="footer-brand__mark-img"
              loading="lazy"
              decoding="async"
            />
          </div>
          <span class="footer-brand__text">PEPTIDE<span class="footer-brand__accent">SHOP</span></span>
        </a>
        <p class="footer-tagline">
          {t('footer.tagline')}
        </p>
        <p style="margin-top: 10px; font-size: 13px; color: #E2E8F0; display: flex; align-items: center; gap: 6px;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#0077B6" stroke-width="2.2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          <span><strong>Standort:</strong> Wien, Österreich</span>
        </p>
        <p style="font-size: 12px; color: #94A3B8; margin-top: 4px; line-height: 1.4;">
          Express-Versand im gesamten DACH-Raum: Österreich, Deutschland &amp; Schweiz.
        </p>
        <div class="footer-trust-chips">
          <span class="trust-chip"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg> {t('footer.trustHplc')}</span>
          <span class="trust-chip"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg> {t('footer.trustCoa')}</span>
          <span class="trust-chip"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg> {t('footer.trustDispatch')}</span>
        </div>
      </div>

      <div class="footer-col">
        <h4>{t('nav.catalogue')}</h4>
        <ul>
          <li><a href={href('/catalog/')}>{t('nav.allResearchAreas')}</a></li>
          {featured.map((a) => (
            <li><a href={href(`/catalog/${a.slug}/`)}>{t(`taxonomy.researchAreas.${a.slug}.name`)}</a></li>
          ))}
          <li><a href={href('/catalog/')}>{t('footer.viewAllAreas')}</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4>{t('nav.useCases')}</h4>
        <ul>
          {useCases.map((u) => (
            <li><a href={href(`/use-case/${u.slug}/`)}>{t(`taxonomy.useCases.${u.slug}.name`)}</a></li>
          ))}
        </ul>
      </div>

      <div class="footer-col">
        <h4>{t('footer.company')}</h4>
        <ul>
          <li><a href={href('/about/')}>{t('nav.about')}</a></li>
          <li><a href={href('/quality/')}>{t('footer.qualityCoaPolicy')}</a></li>
          <li><a href={href('/blog/')}>{t('nav.insights')}</a></li>
          <li><a href={href('/contact/')}>{t('nav.contact')}</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4>{t('footer.orderSupport')}</h4>
        <ul>
          <li><a href={href('/shipping/')}>{t('footer.shippingDelivery')}</a></li>
          <li><a href={href('/versand-oesterreich/')}>Peptide Versand nach Österreich</a></li>
          <li><a href={href('/versand-schweiz/')}>Peptide Versand in die Schweiz</a></li>
          <li><a href={href('/peptid-rechner/')}>Peptid-Dosierungsrechner (ml & IE)</a></li>
          <li><a href={href('/bundles/')}>Forschungs-Kombinationen & Sets</a></li>
          <li><a href={href('/catalog/supplies/')}>Bakteriostatisches Wasser & Zubehör</a></li>
          <li><a href={href('/coa-policy/')}>Analysezertifikate (COA-Richtlinie)</a></li>
          <li><a href={href('/faq/')}>{t('footer.faq')}</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4>{t('footer.newsletter')}</h4>
        <p class="muted" style="font-size: 13px;">
          {t('footer.newsletterBody')}
        </p>
        <form class="newsletter" action={href('/api/newsletter')} method="post" novalidate>
          <input type="hidden" name="locale" value={locale} />
          <input type="text" name="hp" tabindex="-1" autocomplete="off" aria-hidden="true" class="sr-only" />
          <label class="sr-only" for="footer-email">{t('footer.emailAddress')}</label>
          <input class="input" type="email" id="footer-email" name="email" required autocomplete="email" placeholder="you@laboratory.eu" />
          <button type="submit" class="btn btn-primary">{t('footer.subscribe')}</button>
        </form>
        <p class="muted" style="font-size: 11px; margin-top: var(--space-2);">
          {t('footer.privacyConsentStart')} <a href={href('/privacy/')}>{t('footer.privacyPolicy')}</a>.
        </p>
      </div>
    </div>

    <div class="ruo-banner" style="margin-top: var(--space-10);">
      <strong>{t('footer.ruoHeading')}</strong>
      <span>
        {t('footer.ruoBody')}
      </span>
    </div>

    <div class="footer-bottom">
      <p>{t('footer.copyright', { year })} · Peptide Shop HQ Wien, Österreich · DACH-Forschungslogistik</p>
      <ul class="footer-legal">
        <li><a href={href('/impressum/')}>{t('footer.impressum')}</a></li>
        <li><a href={href('/terms/')}>{t('footer.terms')}</a></li>
        <li><a href={href('/privacy/')}>{t('footer.privacy')}</a></li>
        <li><a href={href('/disclaimer/')}>{t('footer.disclaimer')}</a></li>
        <li><a href={href('/coa-policy/')}>{t('footer.coaPolicy')}</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: linear-gradient(180deg, #090E1A 0%, #060A14 100%);
    color: #94A3B8;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-block: var(--space-20) var(--space-10);
    margin-top: var(--space-24);
  }
  .footer-grid {
    display: grid;
    gap: var(--space-8);
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .footer-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .footer-grid {
      grid-template-columns: 1.5fr 1fr 1fr 1fr 1fr 1.3fr;
    }
  }
  .footer-col h4 {
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 700;
    color: #FFFFFF;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--space-4);
  }
  .footer-col ul {
    list-style: none; padding: 0; margin: 0;
    display: grid; gap: 4px;
  }
  .footer-col a {
    color: #94A3B8;
    font-size: 13.5px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    transition: color 150ms ease, transform 150ms ease;
  }
  .footer-col a:hover {
    color: #FFFFFF;
    transform: translateX(2px);
  }

  .footer-brand {
    display: inline-flex; align-items: center; gap: 10px;
    text-decoration: none;
  }
  .footer-brand__text {
    font-family: var(--font-display);
    font-weight: 800;
    color: #FFFFFF;
    font-size: 18px;
    letter-spacing: -0.02em;
  }
  .footer-brand__accent { color: var(--color-primary); }
  .footer-tagline {
    margin-top: var(--space-3);
    color: #64748B;
    font-size: 13.5px;
    line-height: 1.55;
    max-width: 38ch;
  }

  .footer-trust-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: var(--space-4);
  }
  .trust-chip {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: #7DCBF5;
    background: rgba(0, 119, 182, 0.12);
    border: 1px solid rgba(0, 119, 182, 0.25);
    padding: 3px 8px;
    border-radius: var(--radius-xs);
  }

  .newsletter {
    display: flex; gap: var(--space-2); margin-top: var(--space-3);
  }
  .newsletter .input {
    flex: 1;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #FFFFFF;
    border-radius: var(--radius-sm);
    font-size: 13px;
  }
  .newsletter .input:focus {
    border-color: var(--color-primary);
    background: rgba(255, 255, 255, 0.08);
  }

  .ruo-banner {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-md);
    padding: var(--space-4) var(--space-5);
    display: flex;
    flex-direction: column;
    gap: 4px;
    color: #94A3B8;
    font-size: 12.5px;
    line-height: 1.5;
  }
  .ruo-banner strong {
    color: #F59E0B;
    font-family: var(--font-display);
    font-size: 13px;
  }

  .footer-bottom {
    margin-top: var(--space-10);
    padding-top: var(--space-6);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    display: flex; flex-wrap: wrap; gap: var(--space-4);
    justify-content: space-between; align-items: center;
    font-size: 12.5px; color: #64748B;
  }
  .footer-bottom p { margin: 0; }
  .footer-legal {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .footer-legal a {
    color: #64748B;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    transition: color 150ms ease;
  }
  .footer-legal a:hover { color: #FFFFFF; }

  .muted { color: #64748B; }
</style>
